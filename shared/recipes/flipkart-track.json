    ],
    "kn-IN": [
      "ಫ್ಲಿಪ್‌ಕಾರ್ಟ್ ಆರ್ಡರ್ ಎಲ್ಲಿದೆ"
    ],
    "ml-IN": [
      "ഫ്ലിപ്കാർട്ട് ഓർഡർ എവിടെ"
    ]
  },
  "steps": [
    {
      "id": "orders",
      "target": [
        "Orders",
        "My Orders"
      ],
      "status": "done",
      "say": {
        "hi-IN": "'{label}' दबाइए। वहाँ हर सामान के आगे लिखा होगा कि वह कब आएगा।",
        "ta-IN": "'{label}' ஐ அழுத்துங்கள். ஒவ்வொரு பொருளுக்கும் எப்போது வரும் என்று எழுதியிருக்கும்.",
        "te-IN": "'{label}' నొక్కండి. ప్రతి వస్తువు ఎప్పుడు వస్తుందో అక్కడ రాసి ఉంటుంది.",
        "kn-IN": "'{label}' ಒತ್ತಿ. ಪ್ರತಿ ವಸ್ತು ಯಾವಾಗ ಬರುತ್ತದೆ ಎಂದು ಅಲ್ಲಿ ಬರೆದಿರುತ್ತದೆ.",
        "ml-IN": "'{label}' അമർത്തുക. ഓരോ സാധനവും എപ്പോൾ വരുമെന്ന് അവിടെ എഴുതിയിരിക്കും."
      }
    },
    {
      "id": "account",
      "target": [
        "Account",
        "My Account"
      ],
      "exact": true,
      "say": {
        "hi-IN": "नीचे '{label}' पर दबाइए।",
        "ta-IN": "கீழே '{label}' ஐ அழுத்துங்கள்.",
        "te-IN": "కింద '{label}' నొక్కండి.",
        "kn-IN": "ಕೆಳಗೆ '{label}' ಒತ್ತಿ.",
        "ml-IN": "താഴെ '{label}' അമർത്തുക."
      }
    }
