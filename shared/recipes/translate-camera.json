{
  "id": "translate-camera",
  "version": 2,
  "goal": "translate writing with the camera",
  "apps": [
    "com.google.android.apps.translate"
  ],
  "app_label": "Translate",
  "app_names": [
    "Translate",
    "Google Translate"
  ],
  "triggers": [
    {
      "all": [
        [
          "translate",
          "ट्रांसलेट",
          "अनुवाद",
          "மொழிபெயர்",
          "ட்ரான்ஸ்லேட்",
          "అనువాద",
          "ట్రాన్స్‌లేట్",
          "ಅನುವಾದ",
          "ಟ್ರಾನ್ಸ್‌ಲೇಟ್",
          "വിവർത്ത",
          "ട്രാൻസ്‌ലേറ്റ്"
        ]
      ]
    }
  ],
  "examples": {
    "hi-IN": [
      "अंग्रेज़ी का मतलब ट्रांसलेट करके देखना है"
    ],
    "ta-IN": [
      "ஆங்கிலத்தை மொழிபெயர்த்துப் பார்க்க வேண்டும்"
