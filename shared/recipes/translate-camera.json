    "ml-IN": [
      "ഇംഗ്ലീഷ് വിവർത്തനം ചെയ്ത് കാണണം"
    ],
    "en-IN": [
      "translate this board"
    ]
  },
  "steps": [
    {
      "id": "point",
      "after": {
        "step": "camera",
        "min": 1
      },
      "status": "done",
      "say": {
        "hi-IN": "कैमरा लिखे हुए पर रखिए, आपकी भाषा में मतलब वहीं दिख जाएगा।",
        "ta-IN": "கேமராவை எழுத்தின் மேல் வையுங்கள், உங்கள் மொழியில் அர்த்தம் அங்கேயே தெரியும்.",
        "te-IN": "కెమెరాను రాత మీద పెట్టండి, మీ భాషలో అర్థం అక్కడే కనిపిస్తుంది.",
        "kn-IN": "ಕ್ಯಾಮೆರಾವನ್ನು ಬರಹದ ಮೇಲೆ ಇಡಿ, ನಿಮ್ಮ ಭಾಷೆಯಲ್ಲಿ ಅರ್ಥ ಅಲ್ಲೇ ಕಾಣುತ್ತದೆ.",
        "ml-IN": "ക്യാമറ എഴുത്തിന് മുകളിൽ വെക്കുക, നിങ്ങളുടെ ഭാഷയിൽ അർത്ഥം അവിടെ തന്നെ കാണാം.",
        "en-IN": "Hold the camera over the writing; the meaning will show right there in your language."
      }
    },
    {
      "id": "camera",
      "target": [
        "Camera",
        "Camera translation",
        "Translate with camera"
      ],
      "exact": true,
      "say": {
        "hi-IN": "कैमरे वाला निशान दबाइए।",
        "ta-IN": "கேமரா குறியை அழுத்துங்கள்.",
        "te-IN": "కెమెరా గుర్తు నొక్కండి.",
        "kn-IN": "ಕ್ಯಾಮೆರಾ ಗುರುತು ಒತ್ತಿ.",
        "ml-IN": "ക്യാമറ അടയാളം അമർത്തുക.",
        "en-IN": "Press the camera symbol."
      }
    }
  ]
