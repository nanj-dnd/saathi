{
  "id": "spotify-play",
  "version": 2,
  "goal": "play music on Spotify",
  "apps": [
    "com.spotify.music"
  ],
  "app_label": "Spotify",
  "app_names": [
    "Spotify"
  ],
  "triggers": [
    {
      "all": [
        [
          "spotify",
          "स्पॉटिफाई",
          "स्पोटिफाई",
          "ஸ்பாட்டிஃபை",
          "స్పాటిఫై",
          "ಸ್ಪಾಟಿಫೈ",
          "സ്പോട്ടിഫൈ"
        ]
      ]
    },
    {
      "all": [
        [
          "भजन",
          "गाना",
          "गाने",
          "song",
          "bhajan",
          "कीर्तन",
          "आरती",
          "பாட்டு",
          "பாடல்",
          "భజన",
          "పాట",
          "ಭಜನೆ",
          "ಹಾಡು",
          "ഭജന",
          "പാട്ട്"
        ]
      ],
      "in_app": true
    }
  ],
  "examples": {
    "hi-IN": [
      "स्पॉटिफाई पर गाने सुनने हैं"
    ],
    "ta-IN": [
      "ஸ்பாட்டிஃபையில் பாட்டு கேட்க வேண்டும்"
    ],
    "te-IN": [
      "స్పాటిఫైలో పాటలు వినాలి"
    ],
    "kn-IN": [
      "ಸ್ಪಾಟಿಫೈನಲ್ಲಿ ಹಾಡು ಕೇಳಬೇಕು"
    ],
    "ml-IN": [
      "സ്പോട്ടിഫൈയിൽ പാട്ട് കേൾക്കണം"
    ],
    "en-IN": [
      "play songs on Spotify"
    ]
  },
  "steps": [
    {
      "id": "search",
      "target": [
        "Search"
      ],
      "exact": true,
      "status": "done",
      "say": {
        "hi-IN": "ऊपर या नीचे 'Search' दबाइए, गाने या भजन का नाम बोलिए या लिखिए, फिर उस पर दबाइए।",
        "ta-IN": "'Search' ஐ அழுத்தி, பாடலின் பெயரைச் சொல்லுங்கள் அல்லது எழுதுங்கள், பிறகு அதை அழுத்துங்கள்.",
        "te-IN": "'Search' నొక్కి, పాట పేరు చెప్పండి లేదా రాయండి, తర్వాత దాని మీద నొక్కండి.",
        "kn-IN": "'Search' ಒತ್ತಿ, ಹಾಡಿನ ಹೆಸರು ಹೇಳಿ ಅಥವಾ ಬರೆಯಿರಿ, ನಂತರ ಅದರ ಮೇಲೆ ಒತ್ತಿ.",
        "ml-IN": "'Search' അമർത്തി, പാട്ടിന്റെ പേര് പറയുക അല്ലെങ്കിൽ എഴുതുക, പിന്നെ അതിൽ അമർത്തുക.",
        "en-IN": "Press 'Search' at the top or bottom, say or write the name of the song or bhajan, then press it."
      }
    }
  ]
}
