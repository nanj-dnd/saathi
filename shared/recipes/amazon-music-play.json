{
  "id": "amazon-music-play",
  "version": 1,
  "goal": "play music on Amazon Music",
  "apps": [
    "com.amazon.mp3"
  ],
  "app_label": "Amazon Music",
  "app_names": [
    "Amazon Music"
  ],
  "triggers": [
    {
      "all": [
        [
          "amazon music",
          "अमेज़न म्यूज़िक",
          "अमेज़न म्यूजिक",
          "अमेजन म्यूजिक",
          "அமேசான் மியூசிக்",
          "అమెజాన్ మ్యూజిక్",
          "ಅಮೆಜಾನ್ ಮ್ಯೂಸಿಕ್",
          "ആമസോൺ മ്യൂസിക്"
        ]
      ]
    },
    {
      "all": [
        [
          "भजन",
          "गाना",
          "गाने",
          "song",
          "bhajan",
          "कीर्तन",
          "आरती",
          "பாட்டு",
          "பாடல்",
          "భజన",
          "పాట",
          "ಭಜನೆ",
          "ಹಾಡು",
          "ഭജന",
          "പാട്ട്"
        ]
      ],
      "in_app": true
    }
  ],
  "examples": {
    "hi-IN": [
      "अमेज़न म्यूज़िक पर गाने सुनने हैं"
    ],
    "ta-IN": [
      "அமேசான் மியூசிக்கில் பாட்டு கேட்க வேண்டும்"
    ],
    "te-IN": [
      "అమెజాన్ మ్యూజిక్‌లో పాటలు వినాలి"
    ],
    "kn-IN": [
      "ಅಮೆಜಾನ್ ಮ್ಯೂಸಿಕ್‌ನಲ್ಲಿ ಹಾಡು ಕೇಳಬೇಕು"
    ],
    "ml-IN": [
      "ആമസോൺ മ്യൂസിക്കിൽ പാട്ട് കേൾക്കണം"
    ]
  },
  "steps": [
    {
      "id": "search",
      "target": [
        "Search"
      ],
      "exact": true,
      "status": "done",
      "say": {
        "hi-IN": "ऊपर या नीचे 'Search' दबाइए, गाने या भजन का नाम बोलिए या लिखिए, फिर उस पर दबाइए।",
        "ta-IN": "'Search' ஐ அழுத்தி, பாடலின் பெயரைச் சொல்லுங்கள் அல்லது எழுதுங்கள், பிறகு அதை அழுத்துங்கள்.",
        "te-IN": "'Search' నొక్కి, పాట పేరు చెప్పండి లేదా రాయండి, తర్వాత దాని మీద నొక్కండి.",
        "kn-IN": "'Search' ಒತ್ತಿ, ಹಾಡಿನ ಹೆಸರು ಹೇಳಿ ಅಥವಾ ಬರೆಯಿರಿ, ನಂತರ ಅದರ ಮೇಲೆ ಒತ್ತಿ.",
        "ml-IN": "'Search' അമർത്തി, പാട്ടിന്റെ പേര് പറയുക അല്ലെങ്കിൽ എഴുതുക, പിന്നെ അതിൽ അമർത്തുക."
      }
    }
  ]
}
