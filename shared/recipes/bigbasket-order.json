  "steps": [
    {
      "id": "pay",
      "screen_has": [
        [
          "Proceed to Pay",
          "Payment Options",
          "Select payment method",
          "Place Order"
        ]
      ],
      "status": "user_must_do",
      "danger": "sensitive_screen",
      "max_repeats": 2,
      "say": {
        "hi-IN": "पता देख लीजिए कि सही है। आगे पैसे देने का हिस्सा आप खुद कीजिए, PIN किसी को मत बताइए।",
        "ta-IN": "முகவரி சரியா என்று பாருங்கள். பணம் செலுத்தும் பகுதியை நீங்களே செய்யுங்கள், PIN-ஐ யாரிடமும் சொல்லாதீர்கள்.",
        "te-IN": "చిరునామా సరైనదో చూడండి. డబ్బులు కట్టే భాగం మీరే చేయండి, PIN ఎవరికీ చెప్పకండి.",
        "kn-IN": "ವಿಳಾಸ ಸರಿಯಿದೆಯೇ ನೋಡಿ. ಹಣ ಪಾವತಿಸುವ ಭಾಗವನ್ನು ನೀವೇ ಮಾಡಿ, PIN ಯಾರಿಗೂ ಹೇಳಬೇಡಿ.",
        "ml-IN": "വിലാസം ശരിയാണോ എന്ന് നോക്കുക. പണം അടയ്ക്കുന്ന ഭാഗം നിങ്ങൾ തന്നെ ചെയ്യുക, PIN ആരോടും പറയരുത്."
      }
    },
    {
      "id": "view-cart",
      "target": [
        "View Basket",
        "View basket",
        "Checkout"
      ],
      "say": {
        "hi-IN": "'{label}' दबाइए।",
        "ta-IN": "'{label}' ஐ அழுத்துங்கள்.",
        "te-IN": "'{label}' నొక్కండి.",
        "kn-IN": "'{label}' ಒತ್ತಿ.",
        "ml-IN": "'{label}' അമർത്തുക."
      }
    },
    {
      "id": "add",
      "after": {
        "step": "search",
        "min": 1
      },
      "screen_has": [
        [
          "ADD",
          "Add"
        ]
      ],
      "exact": true,
      "max_repeats": 2,
      "say": {
        "hi-IN": "जो सामान चाहिए, उसके पास 'ADD' बटन दबाइए।",
        "ta-IN": "வேண்டிய பொருளின் அருகே உள்ள 'ADD' பொத்தானை அழுத்துங்கள்.",
        "te-IN": "కావాల్సిన దాని పక్కన ఉన్న 'ADD' బటన్ నొక్కండి.",
        "kn-IN": "ಬೇಕಾದುದರ ಪಕ್ಕದ 'ADD' ಬಟನ್ ಒತ್ತಿ.",
        "ml-IN": "വേണ്ടതിനടുത്തുള്ള 'ADD' ബട്ടൺ അമർത്തുക."
      }
    },
    {
      "id": "type",
      "after": {
        "step": "search",
        "min": 1
      },
      "screen_has": [
        [
          "Search"
        ]
      ],
      "max_repeats": 2,
      "say": {
        "hi-IN": "अब सामान का नाम लिखिए, फिर नीचे जो दिखे उस पर दबाइए।",
        "ta-IN": "இப்போது பெயரை எழுதுங்கள், பிறகு கீழே தெரிவதை அழுத்துங்கள்.",
        "te-IN": "ఇప్పుడు పేరు రాయండి, తర్వాత కింద కనిపించేది నొక్కండి.",
        "kn-IN": "ಈಗ ಹೆಸರು ಬರೆಯಿರಿ, ನಂತರ ಕೆಳಗೆ ಕಾಣುವುದನ್ನು ಒತ್ತಿ.",
        "ml-IN": "ഇനി പേര് എഴുതുക, പിന്നെ താഴെ കാണുന്നതിൽ അമർത്തുക."
      }
    },
    {
      "id": "search",
      "target": [
        "Search"
      ],
      "say": {
        "hi-IN": "ऊपर 'Search' वाले डिब्बे पर दबाइए और सामान का नाम लिखिए।",
        "ta-IN": "மேலே 'Search' பெட்டியை அழுத்தி பெயரை எழுதுங்கள்.",
        "te-IN": "పైన 'Search' పెట్టె నొక్కి, పేరు రాయండి.",
        "kn-IN": "ಮೇಲಿನ 'Search' ಪೆಟ್ಟಿಗೆ ಒತ್ತಿ, ಹೆಸರು ಬರೆಯಿರಿ.",
        "ml-IN": "മുകളിലെ 'Search' പെട്ടിയിൽ അമർത്തി പേര് എഴുതുക."
