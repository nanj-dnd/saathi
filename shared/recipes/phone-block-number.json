          "ബ്ലോക്ക്",
          "spam",
          "स्पैम",
          "स्पेम"
        ]
      ]
    }
  ],
  "unless": [
    "whatsapp",
    "whats app",
    "watsapp",
    "व्हाट्सएप",
    "व्हाट्सऐप",
    "वॉट्सऐप",
    "वाट्सएप",
    "वॉट्सएप",
    "व्हाट्सप",
    "வாட்ஸ்அப்",
    "வாட்ஸப்",
    "వాట్సాప్",
    "వాట్సప్",
    "ವಾಟ್ಸಾಪ್",
    "ವಾಟ್ಸ್ಆಪ್",
    "ವಾಟ್ಸಪ್",
    "വാട്ട്സ്ആപ്പ്",
    "വാട്സ്ആപ്പ്",
    "വാട്സാപ്പ്",
    "വാട്സപ്പ്",
    "unblock",
    "अनब्लॉक"
  ],
  "examples": {
    "hi-IN": [
      "फ़ोन पर स्पैम नंबर ब्लॉक करना है"
    ],
    "ta-IN": [
      "ஸ்பேம் நம்பரை பிளாக் செய்ய வேண்டும்"
    ],
    "te-IN": [
      "స్పామ్ నంబర్ బ్లాక్ చేయాలి"
    ],
    "kn-IN": [
      "ಸ್ಪ್ಯಾಮ್ ನಂಬರ್ ಬ್ಲಾಕ್ ಮಾಡಬೇಕು"
    ],
    "ml-IN": [
      "സ്പാം നമ്പർ ബ്ലോക്ക് ചെയ്യണം"
    ]
  },
  "steps": [
    {
      "id": "confirm",
      "after": {
        "step": "block",
        "min": 1
      },
      "target": [
        "Block"
      ],
      "exact": true,
      "status": "done",
      "say": {
        "hi-IN": "पक्का करने के लिए '{label}' दबाइए।",
        "ta-IN": "உறுதிப்படுத்த '{label}' ஐ அழுத்துங்கள்.",
        "te-IN": "నిర్ధారించడానికి '{label}' నొక్కండి.",
        "kn-IN": "ಖಚಿತಪಡಿಸಲು '{label}' ಒತ್ತಿ.",
        "ml-IN": "ഉറപ്പാക്കാൻ '{label}' അമർത്തുക."
      }
    },
    {
      "id": "block",
      "after": {
        "step": "hold",
        "min": 1
      },
      "target": [
        "Block/report spam",
        "Block number",
        "Block"
      ],
      "say": {
        "hi-IN": "'{label}' पर दबाइए।",
        "ta-IN": "'{label}' ஐ அழுத்துங்கள்.",
        "te-IN": "'{label}' నొక్కండి.",
        "kn-IN": "'{label}' ಒತ್ತಿ.",
        "ml-IN": "'{label}' അമർത്തുക."
      }
    },
    {
      "id": "hold",
      "after": {
        "step": "recents",
        "min": 1
      },
      "max_repeats": 2,
      "say": {
        "hi-IN": "जिस नंबर को ब्लॉक करना है, उस पर उंगली दबाकर रखिए।",
        "ta-IN": "பிளாக் செய்ய வேண்டிய எண்ணின் மேல் விரலை அழுத்திப் பிடியுங்கள்.",
        "te-IN": "బ్లాక్ చేయాల్సిన నంబర్ మీద వేలు నొక్కి పట్టుకోండి.",
        "kn-IN": "ಬ್ಲಾಕ್ ಮಾಡಬೇಕಾದ ನಂಬರ್ ಮೇಲೆ ಬೆರಳು ಒತ್ತಿ ಹಿಡಿಯಿರಿ.",
        "ml-IN": "ബ്ലോക്ക് ചെയ്യേണ്ട നമ്പറിൽ വിരൽ അമർത്തിപ്പിടിക്കുക."
      }
    },
    {
      "id": "recents",
      "target": [
        "Recents",
        "Recent",
        "Call history",
        "Logs"
      ],
      "exact": true,
      "say": {
        "hi-IN": "नीचे '{label}' पर दबाइए।",
        "ta-IN": "கீழே '{label}' ஐ அழுத்துங்கள்.",
        "te-IN": "కింద '{label}' నొక్కండి.",
        "kn-IN": "ಕೆಳಗೆ '{label}' ಒತ್ತಿ.",
        "ml-IN": "താഴെ '{label}' അമർത്തുക."
      }
    }
  ]
}
