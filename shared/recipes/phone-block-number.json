{
  "id": "phone-block-number",
  "version": 1,
  "goal": "block a spam caller",
  "apps": [
    "com.google.android.dialer",
    "com.samsung.android.dialer",
    "com.android.dialer",
    "com.android.contacts",
    "com.android.incallui"
  ],
  "app_label": "Phone",
  "app_names": [
    "Phone",
    "फ़ोन",
    "फोन",
    "Dialer",
    "தொலைபேசி",
    "ఫోన్",
    "ಫೋನ್",
    "ഫോൺ"
  ],
  "triggers": [
    {
      "all": [
        [
          "block",
          "ब्लॉक",
          "ब्लाक",
          "பிளாக்",
          "ப்ளாக்",
          "బ్లాక్",
