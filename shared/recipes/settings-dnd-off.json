    "ta-IN": [
      "டூ நாட் டிஸ்டர்ப் அணைக்க வேண்டும்"
    ],
    "te-IN": [
      "డూ నాట్ డిస్టర్బ్ ఆఫ్ చేయాలి"
    ],
    "kn-IN": [
      "ಡೂ ನಾಟ್ ಡಿಸ್ಟರ್ಬ್ ಆಫ್ ಮಾಡಬೇಕು"
    ],
    "ml-IN": [
      "ഡു നോട്ട് ഡിസ്റ്റർബ് ഓഫാക്കണം"
    ],
    "en-IN": [
      "switch off do not disturb"
    ]
  },
  "steps": [
    {
      "id": "done",
      "switch": [
        "Do Not Disturb",
        "Do not disturb",
        "Use Do Not Disturb"
      ],
      "switch_is": "off",
      "status": "done",
      "say": {
        "hi-IN": "डू नॉट डिस्टर्ब बंद है। अब घंटी बजेगी।",
        "ta-IN": "Do Not Disturb அணைந்துள்ளது. இனி மணி ஒலிக்கும்.",
        "te-IN": "Do Not Disturb ఆఫ్‌లో ఉంది. ఇక రింగ్ వస్తుంది.",
        "kn-IN": "Do Not Disturb ಆಫ್ ಆಗಿದೆ. ಇನ್ನು ರಿಂಗ್ ಆಗುತ್ತದೆ.",
        "ml-IN": "Do Not Disturb ഓഫാണ്. ഇനി റിംഗ് ചെയ്യും.",
        "en-IN": "Do Not Disturb is off. The phone will ring now."
      }
    },
    {
      "id": "switch",
      "switch": [
        "Do Not Disturb",
        "Do not disturb",
        "Use Do Not Disturb"
      ],
      "switch_is": "on",
      "tap_switch": true,
      "say": {
