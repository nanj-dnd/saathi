        "kn-IN": "'{label}' ಪಕ್ಕದ ಬಟನ್ ಒತ್ತಿ ಆಫ್ ಮಾಡಿ.",
        "ml-IN": "'{label}'-ന് അടുത്തുള്ള ബട്ടൺ അമർത്തി ഓഫാക്കുക.",
        "en-IN": "Press the switch next to '{label}' to turn it off."
      }
    },
    {
      "id": "dnd",
      "target": [
        "Do Not Disturb",
        "Do not disturb"
      ],
      "say": {
        "hi-IN": "'{label}' पर दबाइए।",
        "ta-IN": "'{label}' ஐ அழுத்துங்கள்.",
        "te-IN": "'{label}' నొక్కండి.",
        "kn-IN": "'{label}' ಒತ್ತಿ.",
        "ml-IN": "'{label}' അമർത്തുക.",
        "en-IN": "Press '{label}'."
      }
    },
    {
      "id": "open",
      "screen_has": [
        [
          "Network & internet",
          "Connections",
          "Connected devices",
          "Battery",
          "Notifications",
          "Sound & vibration",
          "Sounds and vibration",
          "Apps"
        ]
      ],
      "target": [
        "Sound & vibration",
        "Sounds and vibration",
        "Notifications"
      ],
      "say": {
        "hi-IN": "'{label}' पर दबाइए।",
        "ta-IN": "'{label}' ஐ அழுத்துங்கள்.",
        "te-IN": "'{label}' నొక్కండి.",
        "kn-IN": "'{label}' ಒತ್ತಿ.",
        "ml-IN": "'{label}' അമർത്തുക.",
        "en-IN": "Press '{label}'."
      }
    },
    {
      "id": "scroll",
      "screen_has": [
        [
          "Network & internet",
          "Connections",
          "Connected devices",
          "Battery",
          "Notifications",
          "Sound & vibration",
          "Sounds and vibration",
          "Apps"
        ]
      ],
      "max_repeats": 4,
      "say": {
        "hi-IN": "स्क्रीन पर उंगली रखकर ऊपर की ओर सरकाइए।",
        "ta-IN": "திரையில் விரலை வைத்து மேலே தள்ளுங்கள்.",
        "te-IN": "స్క్రీన్‌పై వేలు పెట్టి పైకి జరపండి.",
        "kn-IN": "ಪರದೆಯ ಮೇಲೆ ಬೆರಳಿಟ್ಟು ಮೇಲಕ್ಕೆ ಸರಿಸಿ.",
        "ml-IN": "സ്ക്രീനിൽ വിരൽ വെച്ച് മുകളിലേക്ക് നീക്കുക.",
        "en-IN": "Put your finger on the screen and slide it upwards."
      }
    }
  ]
