{
  "id": "settings-battery-percent",
  "version": 1,
  "goal": "show the battery percentage",
  "apps": [
    "com.android.settings"
  ],
  "app_label": "Settings",
  "app_names": [
    "Settings",
    "सेटिंग",
    "सेटिंग्स",
    "அமைப்புகள்",
    "సెట్టింగ్‌లు",
    "ಸೆಟ್ಟಿಂಗ್‌ಗಳು",
    "ക്രമീകരണങ്ങൾ"
  ],
