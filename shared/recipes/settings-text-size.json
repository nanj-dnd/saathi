  "steps": [
    {
      "id": "done",
      "screen_has": [
        [
          "Font size"
        ]
      ],
      "after": {
        "step": "again",
        "min": 1
      },
      "status": "done",
      "say": {
        "hi-IN": "बहुत बढ़िया! अब अक्षर बड़े हो गए हैं।",
        "ta-IN": "அருமை! இப்போது எழுத்துகள் பெரிதாகிவிட்டன.",
        "te-IN": "చాలా బాగుంది! ఇప్పుడు అక్షరాలు పెద్దవయ్యాయి.",
        "kn-IN": "ತುಂಬಾ ಚೆನ್ನಾಗಿದೆ! ಈಗ ಅಕ್ಷರಗಳು ದೊಡ್ಡದಾಗಿವೆ.",
