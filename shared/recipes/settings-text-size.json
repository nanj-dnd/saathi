        "kn-IN": "'{label}' ಒತ್ತಿ. ಅಕ್ಷರಗಳ ಗಾತ್ರ ಇದರಲ್ಲೇ ಇದೆ.",
        "ml-IN": "'{label}' അമർത്തുക. അക്ഷരങ്ങളുടെ വലുപ്പം ഇതിലാണ്.",
        "en-IN": "Press '{label}'. The text size is in here."
      }
    },
    {
      "id": "scroll",
      "screen_has": [
        [
          "Network & internet",
          "Connections",
