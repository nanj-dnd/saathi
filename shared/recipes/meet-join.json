{
  "id": "meet-join",
  "version": 1,
  "goal": "join a Google Meet call",
  "apps": [
    "com.google.android.apps.tachyon",
    "com.google.android.apps.meetings"
  ],
  "app_label": "Meet",
  "app_names": [
    "Meet",
    "Google Meet"
  ],
  "triggers": [
    {
      "all": [
        [
          "google meet",
          "gmeet",
          "meet link",
          "गूगल मीट",
          "मीट पर",
          "கூகுள் மீட்",
          "గూగుల్ మీట్",
          "ಗೂಗಲ್ ಮೀಟ್",
          "ഗൂഗിൾ മീറ്റ്"
        ],
        [
          "join",
          "जॉइन",
          "जुड़",
          "जुड",
          "शामिल",
          "meeting",
          "मीटिंग",
          "சேர",
          "மீட்டிங்",
          "చేర",
          "మీటింగ్",
          "ಸೇರ",
          "ಮೀಟಿಂಗ್",
          "ചേര",
          "മീറ്റിംഗ്",
          "satsang",
          "सत्संग",
          "class",
          "क्लास"
        ]
      ]
    },
    {
      "all": [
        [
          "google meet",
          "gmeet",
          "meet link",
          "गूगल मीट",
          "मीट पर",
          "கூகுள் மீட்",
          "గూగుల్ మీట్",
          "ಗೂಗಲ್ ಮೀಟ್",
          "ഗൂഗിൾ മീറ്റ്"
        ]
      ]
    }
  ],
  "examples": {
    "hi-IN": [
      "गूगल मीट पर मीटिंग जॉइन करनी है"
    ],
    "ta-IN": [
      "கூகுள் மீட்டில் சேர வேண்டும்"
    ],
    "te-IN": [
      "గూగుల్ మీట్‌లో చేరాలి"
    ],
    "kn-IN": [
      "ಗೂಗಲ್ ಮೀಟ್‌ನಲ್ಲಿ ಸೇರಬೇಕು"
    ],
    "ml-IN": [
      "ഗൂഗിൾ മീറ്റിൽ ചേരണം"
    ]
  },
  "steps": [
    {
      "id": "join",
      "target": [
        "Join now",
        "Ask to join",
        "Join"
      ],
      "exact": true,
      "status": "done",
      "say": {
        "hi-IN": "'{label}' दबाइए। कैमरा और माइक की इजाज़त मांगे तो 'Allow' दबाइए।",
        "ta-IN": "'{label}' ஐ அழுத்துங்கள். கேமரா, மைக் அனுமதி கேட்டால் 'Allow' ஐ அழுத்துங்கள்.",
        "te-IN": "'{label}' నొక్కండి. కెమెరా, మైక్ అనుమతి అడిగితే 'Allow' నొక్కండి.",
        "kn-IN": "'{label}' ಒತ್ತಿ. ಕ್ಯಾಮೆರಾ, ಮೈಕ್ ಅನುಮತಿ ಕೇಳಿದರೆ 'Allow' ಒತ್ತಿ.",
        "ml-IN": "'{label}' അമർത്തുക. ക്യാമറ, മൈക്ക് അനുമതി ചോദിച്ചാൽ 'Allow' അമർത്തുക."
      }
    },
    {
      "id": "code",
      "target": [
        "Join with a code",
        "Join"
      ],
      "max_repeats": 2,
      "say": {
        "hi-IN": "ऊपर 'Join with a code' दबाकर मीटिंग का कोड लिखिए।",
        "ta-IN": "மேலே 'Join with a code' ஐ அழுத்தி மீட்டிங் குறியீட்டை எழுதுங்கள்.",
        "te-IN": "పైన 'Join with a code' నొక్కి మీటింగ్ కోడ్ రాయండి.",
        "kn-IN": "ಮೇಲೆ 'Join with a code' ಒತ್ತಿ ಮೀಟಿಂಗ್ ಕೋಡ್ ಬರೆಯಿರಿ.",
        "ml-IN": "മുകളിൽ 'Join with a code' അമർത്തി മീറ്റിംഗ് കോഡ് എഴുതുക."
      }
    }
  ]
}
