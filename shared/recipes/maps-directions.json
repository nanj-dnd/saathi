{
  "id": "maps-directions",
  "version": 2,
  "goal": "get directions on Google Maps",
  "apps": [
    "com.google.android.apps.maps"
  ],
  "app_label": "Maps",
  "app_names": [
    "Maps",
    "Google Maps",
    "मैप्स"
  ],
  "triggers": [
    {
      "all": [
        [
          "map",
          "मैप",
          "नक्शा",
          "மேப்",
          "வரைபட",
          "మ్యాప్",
          "ಮ್ಯಾಪ್",
          "ನಕ್ಷೆ",
          "മാപ്പ്"
        ],
        [
          "रास्ता",
          "रास्ते",
          "direction",
          "route",
          "way to",
          "कैसे जाऊं",
          "कैसे पहुँच",
          "வழி",
          "దారి",
          "మార్గ",
          "ದಾರಿ",
          "ಮಾರ್ಗ",
          "വഴി"
        ]
      ]
    },
    {
      "all": [
        [
          "रास्ता",
          "रास्ते",
          "direction",
          "route",
          "way to",
          "कैसे जाऊं",
          "कैसे पहुँच",
          "வழி",
          "దారి",
          "మార్గ",
          "ದಾರಿ",
          "ಮಾರ್ಗ",
          "വഴി"
        ]
      ],
      "in_app": true
    }
  ],
  "examples": {
    "hi-IN": [
      "मैप में मंदिर का रास्ता देखना है"
    ],
    "ta-IN": [
      "மேப்பில் கோயிலுக்கு வழி பார்க்க வேண்டும்"
    ],
    "te-IN": [
      "మ్యాప్‌లో గుడికి దారి చూడాలి"
    ],
    "kn-IN": [
      "ಮ್ಯಾಪ್‌ನಲ್ಲಿ ದೇವಸ್ಥಾನಕ್ಕೆ ದಾರಿ ನೋಡಬೇಕು"
    ],
    "ml-IN": [
      "മാപ്പിൽ അമ്പലത്തിലേക്കുള്ള വഴി നോക്കണം"
    ],
    "en-IN": [
      "show me the route on the map"
    ]
  },
  "steps": [
    {
      "id": "start",
      "after": {
        "step": "directions",
        "min": 1
      },
      "target": [
        "Start"
      ],
      "exact": true,
      "status": "done",
      "say": {
        "hi-IN": "नीचे 'Start' दबाइए। रास्ता बोलकर बताया जाएगा।",
        "ta-IN": "கீழே 'Start' ஐ அழுத்துங்கள். வழி பேசிச் சொல்லப்படும்.",
        "te-IN": "కింద 'Start' నొక్కండి. దారి మాటల్లో చెబుతుంది.",
        "kn-IN": "ಕೆಳಗೆ 'Start' ಒತ್ತಿ. ದಾರಿಯನ್ನು ಮಾತಿನಲ್ಲಿ ಹೇಳುತ್ತದೆ.",
        "ml-IN": "താഴെ 'Start' അമർത്തുക. വഴി പറഞ്ഞുതരും.",
        "en-IN": "Press 'Start' at the bottom. The way will be spoken out to you."
      }
    },
    {
      "id": "directions",
      "after": {
        "step": "search",
        "min": 1
      },
      "target": [
        "Directions"
      ],
      "exact": true,
      "say": {
        "hi-IN": "'Directions' पर दबाइए।",
        "ta-IN": "'Directions' ஐ அழுத்துங்கள்.",
        "te-IN": "'Directions' నొక్కండి.",
        "kn-IN": "'Directions' ಒತ್ತಿ.",
        "ml-IN": "'Directions' അമർത്തുക.",
        "en-IN": "Press 'Directions'."
      }
    },
    {
      "id": "type",
      "after": {
        "step": "search",
        "min": 1
      },
      "screen_has": [
        [
          "Search here"
        ]
      ],
      "max_repeats": 2,
      "say": {
        "hi-IN": "जहाँ जाना है उस जगह का नाम लिखिए, फिर नीचे सही जगह पर दबाइए।",
        "ta-IN": "போக வேண்டிய இடத்தின் பெயரை எழுதி, கீழே சரியான இடத்தை அழுத்துங்கள்.",
        "te-IN": "వెళ్ళాల్సిన చోటు పేరు రాసి, కింద సరైన చోటు మీద నొక్కండి.",
        "kn-IN": "ಹೋಗಬೇಕಾದ ಜಾಗದ ಹೆಸರು ಬರೆದು, ಕೆಳಗೆ ಸರಿಯಾದ ಜಾಗದ ಮೇಲೆ ಒತ್ತಿ.",
        "ml-IN": "പോകേണ്ട സ്ഥലത്തിന്റെ പേര് എഴുതി, താഴെ ശരിയായ സ്ഥലത്ത് അമർത്തുക.",
        "en-IN": "Write the name of the place you want to go, then press the right place below."
      }
    },
    {
      "id": "search",
      "target": [
        "Search here"
      ],
      "say": {
        "hi-IN": "ऊपर 'Search here' वाले डिब्बे पर दबाइए।",
        "ta-IN": "மேலே 'Search here' பெட்டியை அழுத்துங்கள்.",
        "te-IN": "పైన 'Search here' పెట్టె నొక్కండి.",
        "kn-IN": "ಮೇಲಿನ 'Search here' ಪೆಟ್ಟಿಗೆ ಒತ್ತಿ.",
        "ml-IN": "മുകളിലെ 'Search here' പെട്ടിയിൽ അമർത്തുക.",
        "en-IN": "Press the 'Search here' box at the top."
      }
    }
  ]
}
