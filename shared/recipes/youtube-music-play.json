        ]
      ]
    },
    {
      "all": [
        [
          "भजन",
          "गाना",
          "गाने",
          "song",
          "bhajan",
          "कीर्तन",
          "आरती",
          "பாட்டு",
          "பாடல்",
          "భజన",
          "పాట",
          "ಭಜನೆ",
          "ಹಾಡು",
          "ഭജന",
          "പാട്ട്"
        ]
      ],
      "in_app": true
    }
  ],
  "examples": {
    "hi-IN": [
      "यूट्यूब म्यूजिक पर भजन सुनने हैं"
    ],
    "en-IN": [
      "play songs on YouTube Music"
    ],
    "ta-IN": [
      "யூடியூப் மியூசிக்கில் பாட்டு கேட்க வேண்டும்"
    ],
    "te-IN": [
      "యూట్యూబ్ మ్యూజిక్‌లో పాటలు వినాలి"
    ],
    "kn-IN": [
      "ಯೂಟ್ಯೂಬ್ ಮ್ಯೂಸಿಕ್‌ನಲ್ಲಿ ಹಾಡು ಕೇಳಬೇಕು"
    ],
    "ml-IN": [
      "യൂട്യൂബ് മ്യൂസിക്കിൽ പാട്ട് കേൾക്കണം"
    ]
  },
  "steps": [
    {
      "id": "search",
      "target": [
        "Search"
      ],
      "exact": true,
      "status": "done",
      "say": {
        "hi-IN": "ऊपर या नीचे 'Search' दबाइए, गाने या भजन का नाम बोलिए या लिखिए, फिर उस पर दबाइए।",
        "en-IN": "Press 'Search' at the top or bottom, say or write the name of the song or bhajan, then press it.",
        "ta-IN": "'Search' ஐ அழுத்தி, பாடலின் பெயரைச் சொல்லுங்கள் அல்லது எழுதுங்கள், பிறகு அதை அழுத்துங்கள்.",
        "te-IN": "'Search' నొక్కి, పాట పేరు చెప్పండి లేదా రాయండి, తర్వాత దాని మీద నొక్కండి.",
        "kn-IN": "'Search' ಒತ್ತಿ, ಹಾಡಿನ ಹೆಸರು ಹೇಳಿ ಅಥವಾ ಬರೆಯಿರಿ, ನಂತರ ಅದರ ಮೇಲೆ ಒತ್ತಿ.",
        "ml-IN": "'Search' അമർത്തി, പാട്ടിന്റെ പേര് പറയുക അല്ലെങ്കിൽ എഴുതുക, പിന്നെ അതിൽ അമർത്തുക."
      }
    }
  ]
}
