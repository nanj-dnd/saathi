{
  "id": "google-search",
  "version": 3,
  "goal": "search on Google",
  "apps": [
    "com.google.android.apps.searchlite",
    "com.google.android.googlequicksearchbox",
    "com.android.chrome"
  ],
  "app_label": "Google",
  "app_names": [
    "Google",
    "Chrome",
    "गूगल",
    "क्रोम"
  ],
  "triggers": [
    {
      "all": [
        [
          "google",
          "गूगल",
          "கூகுள்",
          "గూగుల్",
          "ಗೂಗಲ್",
          "ഗൂഗിൾ",
          "internet",
          "इंटरनेट",
          "chrome",
          "क्रोम"
        ],
        [
          "search",
          "ढूंढ",
          "ढूँढ",
          "खोज",
          "सर्च",
          "पता कर",
          "தேட",
          "தேடு",
          "వెతక",
          "సెర్చ్",
          "ಹುಡುಕ",
          "ಸರ್ಚ್",
          "തിരയ",
          "സെർച്ച്"
        ]
      ]
    }
  ],
  "unless": [
    "youtube",
    "you tube",
    "यूट्यूब",
    "यू ट्यूब",
    "யூடியூப்",
    "యూట్యూబ్",
    "ಯೂಟ್ಯೂಬ್",
    "യൂട്യൂബ്",
    "pay",
    "पे"
  ],
  "examples": {
    "hi-IN": [
      "गूगल पर कुछ ढूंढना है"
    ],
    "ta-IN": [
      "கூகுளில் தேட வேண்டும்"
    ],
    "te-IN": [
      "గూగుల్‌లో వెతకాలి"
    ],
    "kn-IN": [
      "ಗೂಗಲ್‌ನಲ್ಲಿ ಹುಡುಕಬೇಕು"
    ],
    "ml-IN": [
      "ഗൂഗിളിൽ തിരയണം"
    ],
    "en-IN": [
      "search on Google"
    ]
  },
  "steps": [
    {
      "id": "mic",
      "after": {
        "step": "box",
        "min": 1
      },
      "target": [
        "Voice search",
        "Search by voice",
        "Start voice search"
      ],
      "exact": true,
      "status": "done",
      "say": {
        "hi-IN": "माइक वाला निशान दबाइए और बोलिए क्या ढूंढना है, या ऊपर लिखिए।",
        "ta-IN": "மைக் குறியை அழுத்தி என்ன தேட வேண்டும் என்று சொல்லுங்கள், அல்லது மேலே எழுதுங்கள்.",
        "te-IN": "మైక్ గుర్తు నొక్కి ఏం వెతకాలో చెప్పండి, లేదా పైన రాయండి.",
        "kn-IN": "ಮೈಕ್ ಗುರುತು ಒತ್ತಿ ಏನು ಹುಡುಕಬೇಕು ಎಂದು ಹೇಳಿ, ಅಥವಾ ಮೇಲೆ ಬರೆಯಿರಿ.",
        "ml-IN": "മൈക്ക് അടയാളം അമർത്തി എന്താണ് തിരയേണ്ടതെന്ന് പറയുക, അല്ലെങ്കിൽ മുകളിൽ എഴുതുക.",
        "en-IN": "Press the microphone and say what you are looking for, or write it at the top."
      }
    },
    {
      "id": "box",
      "target": [
        "Search or type web address",
        "Search or type URL",
        "Search Voice search Camera search",
        "Search"
      ],
      "max_repeats": 2,
      "say": {
        "hi-IN": "ऊपर लिखने वाले डिब्बे पर दबाइए।",
        "ta-IN": "மேலே எழுதும் பெட்டியை அழுத்துங்கள்.",
        "te-IN": "పైన రాసే పెట్టె నొక్కండి.",
        "kn-IN": "ಮೇಲಿನ ಬರೆಯುವ ಪೆಟ್ಟಿಗೆ ಒತ್ತಿ.",
        "ml-IN": "മുകളിലെ എഴുതുന്ന പെട്ടിയിൽ അമർത്തുക.",
        "en-IN": "Press the writing box at the top."
      }
    }
  ]
}
