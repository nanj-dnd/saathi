  "steps": [
    {
      "id": "pay",
      "screen_has": [
        [
          "Proceed to pay",
          "Payment",
          "Place order",
          "Select payment method"
        ]
      ],
      "status": "user_must_do",
      "danger": "sensitive_screen",
      "max_repeats": 2,
      "say": {
        "hi-IN": "पता देख लीजिए कि सही है। आगे पैसे देने का हिस्सा आप खुद कीजिए; घर पर पैसे देने का विकल्प भी चुन सकते हैं।",
        "ta-IN": "முகவரி சரியா என்று பாருங்கள். பணம் செலுத்தும் பகுதியை நீங்களே செய்யுங்கள்; வீட்டில் பணம் தரும் வசதியையும் தேர்ந்தெடுக்கலாம்.",
        "te-IN": "చిరునామా సరైనదో చూడండి. డబ్బులు కట్టే భాగం మీరే చేయండి; ఇంటి దగ్గర డబ్బు ఇచ్చే ఎంపిక కూడా ఎంచుకోవచ్చు.",
        "kn-IN": "ವಿಳಾಸ ಸರಿಯಿದೆಯೇ ನೋಡಿ. ಹಣ ಪಾವತಿಸುವ ಭಾಗವನ್ನು ನೀವೇ ಮಾಡಿ; ಮನೆಯಲ್ಲಿ ಹಣ ಕೊಡುವ ಆಯ್ಕೆಯನ್ನೂ ಆರಿಸಬಹುದು.",
        "ml-IN": "വിലാസം ശരിയാണോ എന്ന് നോക്കുക. പണം അടയ്ക്കുന്ന ഭാഗം നിങ്ങൾ തന്നെ ചെയ്യുക; വീട്ടിൽ പണം കൊടുക്കുന്ന ഓപ്ഷനും തിരഞ്ഞെടുക്കാം."
      }
    },
    {
      "id": "cart",
      "after": {
        "step": "add",
        "min": 1
      },
      "target": [
        "View cart",
        "Go to cart",
        "View Cart"
      ],
      "say": {
        "hi-IN": "'{label}' दबाइए।",
        "ta-IN": "'{label}' ஐ அழுத்துங்கள்.",
        "te-IN": "'{label}' నొక్కండి.",
        "kn-IN": "'{label}' ಒತ್ತಿ.",
        "ml-IN": "'{label}' അമർത്തുക."
      }
    },
    {
      "id": "add",
      "after": {
        "step": "search",
        "min": 1
      },
      "target": [
        "Add to cart",
        "ADD TO CART",
        "Add"
      ],
      "say": {
        "hi-IN": "दवाई का नाम और ताकत देख लीजिए, फिर '{label}' दबाइए।",
        "ta-IN": "மருந்தின் பெயரையும் அளவையும் பார்த்து, பிறகு '{label}' ஐ அழுத்துங்கள்.",
        "te-IN": "మందు పేరు, మోతాదు చూసి, తర్వాత '{label}' నొక్కండి.",
        "kn-IN": "ಔಷಧದ ಹೆಸರು ಮತ್ತು ಪ್ರಮಾಣ ನೋಡಿ, ನಂತರ '{label}' ಒತ್ತಿ.",
        "ml-IN": "മരുന്നിന്റെ പേരും അളവും നോക്കി, പിന്നെ '{label}' അമർത്തുക."
      }
    },
    {
      "id": "search",
      "target": [
        "Search for Medicines",
        "Search for medicines",
        "Search"
      ],
      "say": {
        "hi-IN": "ऊपर खोजने वाले डिब्बे पर दबाइए और पर्ची पर लिखा दवाई का नाम लिखिए।",
        "ta-IN": "மேலே தேடும் பெட்டியை அழுத்தி சீட்டில் உள்ள மருந்தின் பெயரை எழுதுங்கள்.",
        "te-IN": "పైన వెతికే పెట్టె నొక్కి, చీటీ మీద ఉన్న మందు పేరు రాయండి.",
        "kn-IN": "ಮೇಲಿನ ಹುಡುಕುವ ಪೆಟ್ಟಿಗೆ ಒತ್ತಿ, ಚೀಟಿಯ ಮೇಲಿನ ಔಷಧದ ಹೆಸರು ಬರೆಯಿರಿ.",
        "ml-IN": "മുകളിലെ തിരയുന്ന പെട്ടിയിൽ അമർത്തി കുറിപ്പിലെ മരുന്നിന്റെ പേര് എഴുതുക."
      }
    }
