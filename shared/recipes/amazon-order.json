  ],
  "examples": {
    "hi-IN": [
      "अमेज़न से चप्पल मंगानी है"
    ],
    "ta-IN": [
      "அமேசானில் செருப்பு ஆர்டர் செய்ய வேண்டும்"
    ],
    "te-IN": [
      "అమెజాన్‌లో చెప్పులు ఆర్డర్ చేయాలి"
    ],
    "kn-IN": [
      "ಅಮೆಜಾನ್‌ನಲ್ಲಿ ಚಪ್ಪಲಿ ಆರ್ಡರ್ ಮಾಡಬೇಕು"
    ],
    "ml-IN": [
      "ആമസോണിൽ ചെരുപ്പ് ഓർഡർ ചെയ്യണം"
    ],
    "en-IN": [
      "I want to buy something on Amazon"
    ]
  },
  "steps": [
    {
      "id": "pay",
      "screen_has": [
        [
          "Select a payment method",
          "Place your order",
          "Use this payment method",
          "Deliver to this address"
        ]
      ],
      "status": "user_must_do",
      "danger": "sensitive_screen",
      "max_repeats": 2,
      "say": {
        "hi-IN": "पता देख लीजिए कि सही है। आगे पैसे देने का हिस्सा आप खुद कीजिए; घर पर पैसे देने का विकल्प भी चुन सकते हैं।",
        "ta-IN": "முகவரி சரியா என்று பாருங்கள். பணம் செலுத்தும் பகுதியை நீங்களே செய்யுங்கள்; வீட்டில் பணம் தரும் வசதியையும் தேர்ந்தெடுக்கலாம்.",
        "te-IN": "చిరునామా సరైనదో చూడండి. డబ్బులు కట్టే భాగం మీరే చేయండి; ఇంటి దగ్గర డబ్బు ఇచ్చే ఎంపిక కూడా ఎంచుకోవచ్చు.",
        "kn-IN": "ವಿಳಾಸ ಸರಿಯಿದೆಯೇ ನೋಡಿ. ಹಣ ಪಾವತಿಸುವ ಭಾಗವನ್ನು ನೀವೇ ಮಾಡಿ; ಮನೆಯಲ್ಲಿ ಹಣ ಕೊಡುವ ಆಯ್ಕೆಯನ್ನೂ ಆರಿಸಬಹುದು.",
        "ml-IN": "വിലാസം ശരിയാണോ എന്ന് നോക്കുക. പണം അടയ്ക്കുന്ന ഭാഗം നിങ്ങൾ തന്നെ ചെയ്യുക; വീട്ടിൽ പണം കൊടുക്കുന്ന ഓപ്ഷനും തിരഞ്ഞെടുക്കാം.",
        "en-IN": "Check that the address is correct. Do the payment part yourself; you can also choose to pay at home on delivery."
      }
    },
    {
      "id": "cart",
      "after": {
        "step": "add",
        "min": 1
      },
      "target": [
        "Go to Cart",
        "Cart",
        "Proceed to Buy"
      ],
      "say": {
        "hi-IN": "'{label}' दबाइए।",
        "ta-IN": "'{label}' ஐ அழுத்துங்கள்.",
        "te-IN": "'{label}' నొక్కండి.",
        "kn-IN": "'{label}' ಒತ್ತಿ.",
        "ml-IN": "'{label}' അമർത്തുക.",
        "en-IN": "Press '{label}'."
      }
    },
    {
      "id": "add",
      "target": [
        "Add to Cart",
        "Add to cart"
      ],
      "say": {
        "hi-IN": "'{label}' वाला पीला बटन दबाइए।",
        "ta-IN": "'{label}' என்ற மஞ்சள் பொத்தானை அழுத்துங்கள்.",
        "te-IN": "'{label}' అనే పసుపు బటన్ నొక్కండి.",
        "kn-IN": "'{label}' ಎಂಬ ಹಳದಿ ಬಟನ್ ಒತ್ತಿ.",
        "ml-IN": "'{label}' എന്ന മഞ്ഞ ബട്ടൺ അമർത്തുക.",
        "en-IN": "Press the yellow '{label}' button."
      }
    },
    {
      "id": "pick",
      "after": {
        "step": "search",
        "min": 1
      },
      "max_repeats": 2,
      "say": {
        "hi-IN": "जो सामान चाहिए उसकी फोटो पर दबाइए। दाम और नाम देख लीजिए।",
        "ta-IN": "வேண்டிய பொருளின் படத்தை அழுத்துங்கள். விலையையும் பெயரையும் பாருங்கள்.",
        "te-IN": "కావాల్సిన వస్తువు ఫోటో మీద నొక్కండి. ధర, పేరు చూడండి.",
        "kn-IN": "ಬೇಕಾದ ವಸ್ತುವಿನ ಫೋಟೋ ಮೇಲೆ ಒತ್ತಿ. ಬೆಲೆ ಮತ್ತು ಹೆಸರು ನೋಡಿ.",
        "ml-IN": "വേണ്ട സാധനത്തിന്റെ ഫോട്ടോയിൽ അമർത്തുക. വിലയും പേരും നോക്കുക.",
        "en-IN": "Press the photo of the item you want. Check the price and the name."
      }
    },
    {
      "id": "search",
      "target": [
        "Search Amazon.in",
        "Search Amazon",
        "Search"
      ],
      "say": {
        "hi-IN": "ऊपर खोजने वाले डिब्बे पर दबाइए और सामान का नाम लिखिए।",
        "ta-IN": "மேலே தேடும் பெட்டியை அழுத்தி பொருளின் பெயரை எழுதுங்கள்.",
        "te-IN": "పైన వెతికే పెట్టె నొక్కి, వస్తువు పేరు రాయండి.",
        "kn-IN": "ಮೇಲಿನ ಹುಡುಕುವ ಪೆಟ್ಟಿಗೆ ಒತ್ತಿ, ವಸ್ತುವಿನ ಹೆಸರು ಬರೆಯಿರಿ.",
        "ml-IN": "മുകളിലെ തിരയുന്ന പെട്ടിയിൽ അമർത്തി സാധനത്തിന്റെ പേര് എഴുതുക.",
        "en-IN": "Press the search box at the top and write the item's name."
      }
    }
  ]
}
