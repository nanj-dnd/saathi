{
  "id": "settings-hotspot-on",
  "version": 1,
  "goal": "share internet with a hotspot",
  "apps": [
    "com.android.settings"
  ],
  "app_label": "Settings",
  "app_names": [
    "Settings",
    "सेटिंग",
    "सेटिंग्स",
    "அமைப்புகள்",
    "సెట్టింగ్‌లు",
    "ಸೆಟ್ಟಿಂಗ್‌ಗಳು",
    "ക്രമീകരണങ്ങൾ"
  ],
  "triggers": [
    {
      "all": [
        [
          "hotspot",
          "हॉटस्पॉट",
          "हॉट स्पॉट",
          "इंटरनेट शेयर",
          "नेट शेयर",
          "net share",
          "internet share",
          "ஹாட்ஸ்பாட்",
          "హాట్‌స్పాట్",
          "ಹಾಟ್‌ಸ್ಪಾಟ್",
          "ഹോട്ട്സ്പോട്ട്"
        ]
      ]
    }
  ],
  "unless": [
    "off",
    "बंद",
    "ऑफ",
    "ஆஃப்",
    "அணை",
    "నిలిపి",
    "ఆఫ్",
    "ಆಫ್",
    "ഓഫ്"
  ],
  "examples": {
    "hi-IN": [
      "हॉटस्पॉट चालू करना है",
      "पोते के फ़ोन में नेट शेयर करना है"
    ],
    "ta-IN": [
      "ஹாட்ஸ்பாட் ஆன் செய்ய வேண்டும்"
    ],
    "te-IN": [
      "హాట్‌స్పాట్ ఆన్ చేయాలి"
    ],
    "kn-IN": [
      "ಹಾಟ್‌ಸ್ಪಾಟ್ ಆನ್ ಮಾಡಬೇಕು"
    ],
    "ml-IN": [
      "ഹോട്ട്സ്പോട്ട് ഓണാക്കണം"
    ]
  },
  "steps": [
    {
      "id": "done",
      "switch": [
        "Wi-Fi hotspot",
        "Mobile Hotspot",
        "Use Wi-Fi hotspot",
        "Hotspot"
      ],
      "switch_is": "on",
      "status": "done",
      "say": {
        "hi-IN": "हॉटस्पॉट चालू है। दूसरे फ़ोन में वाई-फाई खोलकर आपके फ़ोन का नाम चुनें; पासवर्ड इसी स्क्रीन पर लिखा है।",
        "ta-IN": "ஹாட்ஸ்பாட் இயக்கத்தில் உள்ளது. மற்ற போனில் Wi-Fi திறந்து உங்கள் போனின் பெயரைத் தேர்ந்தெடுக்கவும்; பாஸ்வேர்ட் இந்தத் திரையில் உள்ளது.",
        "te-IN": "హాట్‌స్పాట్ ఆన్‌లో ఉంది. ఇంకో ఫోన్‌లో Wi-Fi తెరిచి మీ ఫోన్ పేరు ఎంచుకోండి; పాస్‌వర్డ్ ఈ స్క్రీన్‌లోనే ఉంది.",
        "kn-IN": "ಹಾಟ್‌ಸ್ಪಾಟ್ ಆನ್ ಆಗಿದೆ. ಇನ್ನೊಂದು ಫೋನಿನಲ್ಲಿ Wi-Fi ತೆರೆದು ನಿಮ್ಮ ಫೋನಿನ ಹೆಸರು ಆಯ್ಕೆ ಮಾಡಿ; ಪಾಸ್‌ವರ್ಡ್ ಈ ಪರದೆಯಲ್ಲೇ ಇದೆ.",
        "ml-IN": "ഹോട്ട്സ്പോട്ട് ഓണാണ്. മറ്റേ ഫോണിൽ Wi-Fi തുറന്ന് നിങ്ങളുടെ ഫോണിന്റെ പേര് തിരഞ്ഞെടുക്കുക; പാസ്‌വേഡ് ഈ സ്ക്രീനിൽ തന്നെയുണ്ട്."
      }
    },
    {
      "id": "switch",
      "switch": [
        "Wi-Fi hotspot",
        "Mobile Hotspot",
        "Use Wi-Fi hotspot",
        "Hotspot"
      ],
      "switch_is": "off",
      "tap_switch": true,
      "say": {
        "hi-IN": "'{label}' के सामने वाला बटन दबाइए, वह चालू हो जाएगा।",
        "ta-IN": "'{label}' அருகே உள்ள பொத்தானை அழுத்துங்கள், அது இயங்கும்.",
        "te-IN": "'{label}' పక్కన ఉన్న బటన్ నొక్కండి, అది ఆన్ అవుతుంది.",
        "kn-IN": "'{label}' ಪಕ್ಕದ ಬಟನ್ ಒತ್ತಿ, ಅದು ಆನ್ ಆಗುತ್ತದೆ.",
        "ml-IN": "'{label}'-ന് അടുത്തുള്ള ബട്ടൺ അമർത്തുക, അത് ഓണാകും."
      }
    },
    {
      "id": "hotspot-page",
      "target": [
        "Wi-Fi hotspot",
        "Mobile Hotspot",
        "Mobile Hotspot and Tethering"
      ],
      "say": {
        "hi-IN": "'{label}' पर दबाइए।",
        "ta-IN": "'{label}' ஐ அழுத்துங்கள்.",
        "te-IN": "'{label}' నొక్కండి.",
        "kn-IN": "'{label}' ಒತ್ತಿ.",
        "ml-IN": "'{label}' അമർത്തുക."
      }
    },
    {
      "id": "tether",
      "screen_has": [
        [
          "Airplane mode",
          "Flight mode",
          "SIMs",
          "Hotspot & tethering",
          "Mobile network",
          "Data Saver",
          "Data usage",
          "Private DNS",
          "Data usage"
        ]
      ],
      "target": [
        "Hotspot & tethering",
        "Mobile Hotspot and Tethering"
      ],
      "say": {
        "hi-IN": "'{label}' पर दबाइए।",
        "ta-IN": "'{label}' ஐ அழுத்துங்கள்.",
        "te-IN": "'{label}' నొక్కండి.",
        "kn-IN": "'{label}' ಒತ್ತಿ.",
        "ml-IN": "'{label}' അമർത്തുക."
      }
    },
    {
      "id": "open",
      "screen_has": [
        [
          "Network & internet",
          "Connections",
          "Connected devices",
          "Battery",
          "Notifications",
          "Sound & vibration",
          "Sounds and vibration",
          "Apps"
        ]
      ],
      "target": [
        "Network & internet",
        "Connections",
        "Network and internet"
      ],
      "say": {
        "hi-IN": "'{label}' पर दबाइए।",
        "ta-IN": "'{label}' ஐ அழுத்துங்கள்.",
        "te-IN": "'{label}' నొక్కండి.",
        "kn-IN": "'{label}' ಒತ್ತಿ.",
        "ml-IN": "'{label}' അമർത്തുക."
      }
    },
    {
      "id": "scroll",
      "screen_has": [
        [
          "Network & internet",
          "Connections",
          "Connected devices",
          "Battery",
          "Notifications",
          "Sound & vibration",
          "Sounds and vibration",
          "Apps"
        ]
      ],
      "max_repeats": 4,
      "say": {
        "hi-IN": "स्क्रीन पर उंगली रखकर ऊपर की ओर सरकाइए।",
        "ta-IN": "திரையில் விரலை வைத்து மேலே தள்ளுங்கள்.",
        "te-IN": "స్క్రీన్‌పై వేలు పెట్టి పైకి జరపండి.",
        "kn-IN": "ಪರದೆಯ ಮೇಲೆ ಬೆರಳಿಟ್ಟು ಮೇಲಕ್ಕೆ ಸರಿಸಿ.",
        "ml-IN": "സ്ക്രീനിൽ വിരൽ വെച്ച് മുകളിലേക്ക് നീക്കുക."
      }
