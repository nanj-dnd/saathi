{
  "id": "gpay-recharge",
  "version": 1,
  "goal": "recharge a mobile on Google Pay",
  "apps": [
    "com.google.android.apps.nbu.paisa.user"
  ],
  "app_label": "Google Pay",
  "app_names": [
    "Google Pay",
    "GPay"
  ],
  "triggers": [
    {
      "all": [
        [
          "google pay",
          "gpay",
          "g pay",
          "गूगल पे",
          "जी पे",
          "கூகுள் பே",
          "గూగుల్ పే",
          "ಗೂಗಲ್ ಪೇ",
          "ഗൂഗിൾ പേ"
        ],
        [
          "recharge",
          "रिचार्ज",
          "रीचार्ज",
          "ரீசார்ஜ்",
          "రీఛార్జ్",
          "రీచార్జ్",
          "ರೀಚಾರ್ಜ್",
          "റീചാർജ്"
        ]
      ]
    },
    {
      "all": [
        [
          "recharge",
          "रिचार्ज",
          "रीचार्ज",
          "ரீசார்ஜ்",
          "రీఛార్జ్",
          "రీచార్జ్",
          "ರೀಚಾರ್ಜ್",
          "റീചാർജ്"
        ]
      ],
      "in_app": true
    }
  ],
  "unless": [
    "status",
    "स्टेटस",
    "refund",
    "रिफंड",
    "complaint",
    "शिकायत",
    "cut",
    "कट",
    "katega",
    "कटेगा",
    "disconnect"
  ],
  "examples": {
    "hi-IN": [
      "गूगल पे से रिचार्ज करना है"
    ],
    "ta-IN": [
      "கூகுள் பேயில் ரீசார்ஜ் செய்ய வேண்டும்"
    ],
    "te-IN": [
      "గూగుల్ పేలో రీఛార్జ్ చేయాలి"
    ],
    "kn-IN": [
      "ಗೂಗಲ್ ಪೇನಲ್ಲಿ ರೀಚಾರ್ಜ್ ಮಾಡಬೇಕು"
    ],
    "ml-IN": [
      "ഗൂഗിൾ പേയിൽ റീചാർജ് ചെയ്യണം"
    ]
  },
  "steps": [
    {
      "id": "tile",
      "target": [
        "Mobile recharge",
        "Recharge"
      ],
      "status": "user_must_do",
      "say": {
        "hi-IN": "'{label}' दबाइए, फिर अपना नंबर और प्लान चुनिए। पैसे देने का हिस्सा आप खुद कीजिए।",
        "ta-IN": "'{label}' ஐ அழுத்துங்கள், பிறகு உங்கள் எண்ணையும் திட்டத்தையும் தேர்ந்தெடுங்கள். பணம் செலுத்தும் பகுதியை நீங்களே செய்யுங்கள்.",
        "te-IN": "'{label}' నొక్కండి, తర్వాత మీ నంబర్, ప్లాన్ ఎంచుకోండి. డబ్బులు కట్టే భాగం మీరే చేయండి.",
        "kn-IN": "'{label}' ಒತ್ತಿ, ನಂತರ ನಿಮ್ಮ ನಂಬರ್ ಮತ್ತು ಪ್ಲಾನ್ ಆಯ್ಕೆ ಮಾಡಿ. ಹಣ ಪಾವತಿಸುವ ಭಾಗವನ್ನು ನೀವೇ ಮಾಡಿ.",
        "ml-IN": "'{label}' അമർത്തുക, പിന്നെ നിങ്ങളുടെ നമ്പറും പ്ലാനും തിരഞ്ഞെടുക്കുക. പണം അടയ്ക്കുന്ന ഭാഗം നിങ്ങൾ തന്നെ ചെയ്യുക."
      }
    },
    {
      "id": "scroll",
      "screen_has": [
        [
          "Scan any QR code",
          "Pay phone number",
          "Pay contacts",
          "Pay UPI ID or number",
          "Bank transfer",
          "Pay anyone"
        ]
      ],
      "max_repeats": 3,
      "say": {
        "hi-IN": "स्क्रीन पर उंगली रखकर ऊपर की ओर सरकाइए।",
        "ta-IN": "திரையில் விரலை வைத்து மேலே தள்ளுங்கள்.",
        "te-IN": "స్క్రీన్‌పై వేలు పెట్టి పైకి జరపండి.",
        "kn-IN": "ಪರದೆಯ ಮೇಲೆ ಬೆರಳಿಟ್ಟು ಮೇಲಕ್ಕೆ ಸರಿಸಿ.",
        "ml-IN": "സ്ക്രീനിൽ വിരൽ വെച്ച് മുകളിലേക്ക് നീക്കുക."
      }
    }
  ]
}
