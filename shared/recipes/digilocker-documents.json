{
  "id": "digilocker-documents",
  "version": 1,
  "goal": "see my documents in DigiLocker",
  "apps": [
    "com.digilocker.android"
  ],
  "app_label": "DigiLocker",
  "app_names": [
    "DigiLocker"
  ],
  "triggers": [
    {
      "all": [
        [
          "digilocker",
          "digi locker",
          "डिजिलॉकर",
          "डिजी लॉकर",
          "டிஜிலாக்கர்",
          "డిజిలాకర్",
          "ಡಿಜಿಲಾಕರ್",
          "ഡിജിലോക്കർ",
          "ഡിജിലോക്കറ"
        ]
      ]
    },
    {
      "all": [
        [
          "aadhaar",
          "aadhar",
          "आधार",
          "pan",
          "पैन",
          "licence",
          "license",
          "लाइसेंस",
          "document",
          "दस्तावेज़",
          "कागज़",
          "ஆதார்",
          "ஆவண",
          "ఆధార్",
          "పత్రాల",
          "ಆಧಾರ್",
          "ದಾಖಲೆ",
          "ആധാർ",
          "രേഖ"
        ],
        [
          "देख",
          "दिखा",
          "see",
          "show",
          "பார்க்க",
          "చూడ",
          "ನೋಡ",
          "കാണ"
        ]
      ],
      "in_app": true
    }
  ],
  "examples": {
    "hi-IN": [
      "डिजिलॉकर में आधार देखना है"
    ],
    "ta-IN": [
      "டிஜிலாக்கரில் ஆதார் பார்க்க வேண்டும்"
    ],
    "te-IN": [
      "డిజిలాకర్‌లో ఆధార్ చూడాలి"
    ],
    "kn-IN": [
      "ಡಿಜಿಲಾಕರ್‌ನಲ್ಲಿ ಆಧಾರ್ ನೋಡಬೇಕು"
    ],
    "ml-IN": [
      "ഡിജിലോക്കറിൽ ആധാർ കാണണം"
    ]
  },
  "steps": [
    {
      "id": "open",
      "after": {
        "step": "issued",
        "min": 1
      },
      "status": "done",
      "say": {
        "hi-IN": "जो कागज़ देखना है, उसके नाम पर दबाइए।",
        "ta-IN": "பார்க்க வேண்டிய ஆவணத்தின் பெயரை அழுத்துங்கள்.",
        "te-IN": "చూడాల్సిన పత్రం పేరు మీద నొక్కండి.",
        "kn-IN": "ನೋಡಬೇಕಾದ ದಾಖಲೆಯ ಹೆಸರಿನ ಮೇಲೆ ಒತ್ತಿ.",
        "ml-IN": "കാണേണ്ട രേഖയുടെ പേരിൽ അമർത്തുക."
      }
    },
    {
      "id": "issued",
      "target": [
        "Issued Documents",
        "Issued",
        "Documents"
      ],
      "say": {
        "hi-IN": "'{label}' पर दबाइए।",
        "ta-IN": "'{label}' ஐ அழுத்துங்கள்.",
        "te-IN": "'{label}' నొక్కండి.",
        "kn-IN": "'{label}' ಒತ್ತಿ.",
        "ml-IN": "'{label}' അമർത്തുക."
      }
    }
  ]
}
