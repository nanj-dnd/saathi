{
  "id": "primevideo-watch",
  "version": 1,
  "goal": "watch something on Prime Video",
  "apps": [
    "com.amazon.avod.thirdpartyclient"
  ],
  "app_label": "Prime Video",
  "app_names": [
    "Prime Video",
    "प्राइम वीडियो"
  ],
  "triggers": [
    {
      "all": [
        [
          "prime video",
          "प्राइम वीडियो",
          "amazon prime",
          "अमेज़न प्राइम",
          "अमेजन प्राइम",
          "ப்ரைம் வீடியோ",
          "பிரைம் வீடியோ",
          "ప్రైమ్ వీడియో",
          "ಪ್ರೈಮ್ ವೀಡಿಯೊ",
          "ಪ್ರೈಮ್ ವಿಡಿಯೋ",
          "പ്രൈം വീഡിയോ"
        ]
      ]
    }
  ],
  "examples": {
    "hi-IN": [
      "प्राइम वीडियो पर फ़िल्म देखनी है"
    ],
    "ta-IN": [
      "ப்ரைம் வீடியோவில் படம் பார்க்க வேண்டும்"
    ],
    "te-IN": [
      "ప్రైమ్ వీడియోలో సినిమా చూడాలి"
    ],
    "kn-IN": [
      "ಪ್ರೈಮ್ ವೀಡಿಯೊದಲ್ಲಿ ಸಿನಿಮಾ ನೋಡಬೇಕು"
    ],
    "ml-IN": [
      "പ്രൈം വീഡിയോയിൽ സിനിമ കാണണം"
    ]
  },
  "steps": [
    {
      "id": "type",
      "after": {
        "step": "search",
        "min": 1
      },
      "status": "done",
      "say": {
        "hi-IN": "जो देखना है उसका नाम बोलिए या लिखिए, फिर नीचे उस पर दबाइए।",
        "ta-IN": "பார்க்க வேண்டியதன் பெயரைச் சொல்லுங்கள் அல்லது எழுதுங்கள், பிறகு கீழே அதை அழுத்துங்கள்.",
        "te-IN": "చూడాల్సిన దాని పేరు చెప్పండి లేదా రాయండి, తర్వాత కింద దాని మీద నొక్కండి.",
        "kn-IN": "ನೋಡಬೇಕಾದುದರ ಹೆಸರು ಹೇಳಿ ಅಥವಾ ಬರೆಯಿರಿ, ನಂತರ ಕೆಳಗೆ ಅದರ ಮೇಲೆ ಒತ್ತಿ.",
        "ml-IN": "കാണേണ്ടതിന്റെ പേര് പറയുക അല്ലെങ്കിൽ എഴുതുക, പിന്നെ താഴെ അതിൽ അമർത്തുക."
      }
    },
    {
      "id": "search",
      "target": [
        "Search",
        "Find"
      ],
      "exact": true,
      "say": {
        "hi-IN": "नीचे '{label}' वाला निशान दबाइए।",
        "ta-IN": "கீழே உள்ள '{label}' குறியை அழுத்துங்கள்.",
        "te-IN": "కింద ఉన్న '{label}' గుర్తు నొక్కండి.",
        "kn-IN": "ಕೆಳಗಿನ '{label}' ಗುರುತು ಒತ್ತಿ.",
        "ml-IN": "താഴെയുള്ള '{label}' അടയാളം അമർത്തുക."
      }
    }
  ]
}
