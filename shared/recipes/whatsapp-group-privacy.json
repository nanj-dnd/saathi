      ],
      "exact": true,
      "say": {
        "hi-IN": "'{label}' पर दबाइए।",
        "ta-IN": "'{label}' ஐ அழுத்துங்கள்.",
        "te-IN": "'{label}' నొక్కండి.",
        "kn-IN": "'{label}' ಒತ್ತಿ.",
        "ml-IN": "'{label}' അമർത്തുക."
      }
    },
    {
      "id": "menu",
      "screen_has": [
        [
          "Chats",
          "चैट",
          "சாட்கள்",
          "చాట్‌లు",
          "ಚಾಟ್‌ಗಳು",
          "ചാറ്റുകൾ"
        ]
      ],
      "target": [
        "More options"
      ],
      "exact": true,
      "say": {
        "hi-IN": "ऊपर दाईं ओर तीन बिंदु वाला निशान दबाइए।",
        "ta-IN": "மேலே வலது பக்கம் உள்ள மூன்று புள்ளி குறியை அழுத்துங்கள்.",
        "te-IN": "పైన కుడి వైపు ఉన్న మూడు చుక్కల గుర్తు నొక్కండి.",
        "kn-IN": "ಮೇಲೆ ಬಲಭಾಗದ ಮೂರು ಚುಕ್ಕೆಗಳ ಗುರುತು ಒತ್ತಿ.",
        "ml-IN": "മുകളിൽ വലതുവശത്തുള്ള മൂന്ന് കുത്തുകളുടെ അടയാളം അമർത്തുക."
      }
    },
    {
      "id": "back",
      "screen_has": [
        [
          "Attach"
        ]
      ],
      "target": [
        "Navigate up"
      ],
      "exact": true,
      "max_repeats": 2,
      "say": {
        "hi-IN": "ऊपर बाईं ओर तीर वाला निशान दबाकर चैट की सूची पर आइए।",
        "ta-IN": "மேலே இடது பக்கம் உள்ள அம்புக்குறியை அழுத்தி சாட் பட்டியலுக்கு வாருங்கள்.",
        "te-IN": "పైన ఎడమ వైపు ఉన్న బాణం గుర్తు నొక్కి చాట్ జాబితాకు రండి.",
        "kn-IN": "ಮೇಲೆ ಎಡಭಾಗದ ಬಾಣದ ಗುರುತು ಒತ್ತಿ ಚಾಟ್ ಪಟ್ಟಿಗೆ ಬನ್ನಿ.",
        "ml-IN": "മുകളിൽ ഇടതുവശത്തെ അമ്പടയാളം അമർത്തി ചാറ്റ് ലിസ്റ്റിലേക്ക് വരുക."
      }
