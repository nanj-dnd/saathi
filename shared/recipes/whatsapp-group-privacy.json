          "జోడి",
          "యాడ్",
          "చేర్చ",
          "సేవ్",
          "ಸೇರಿಸ",
          "ಆ್ಯಡ್",
          "ಸೇವ್",
          "ചേർക്ക",
          "ആഡ്",
          "സേവ്"
        ],
        [
          "unknown",
          "stranger",
