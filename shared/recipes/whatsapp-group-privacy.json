      "all": [
        [
          "group",
          "ग्रुप",
          "समूह",
          "குழு",
          "குரூப்",
          "గ్రూప్",
          "గ్రూపు",
          "ಗ್ರೂಪ್",
          "ಗುಂಪು",
          "ഗ്രൂപ്പ്"
        ],
        [
          "add",
          "ऐड",
          "जोड़",
          "जोड",
          "डाल",
          "सेव",
          "save",
          "சேர்க்க",
