{
  "id": "whatsapp-group-privacy",
  "version": 1,
  "goal": "stop strangers adding me to WhatsApp groups",
  "apps": [
    "com.whatsapp",
    "com.whatsapp.w4b"
  ],
  "app_label": "WhatsApp",
  "app_names": [
    "WhatsApp",
    "व्हाट्सएप",
    "வாட்ஸ்அப்",
    "వాట్సాప్",
    "ವಾಟ್ಸಾಪ್",
    "വാട്ട്സ്ആപ്പ്"
  ],
  "triggers": [
