{
  "id": "clock-timer",
  "version": 2,
  "goal": "set a timer",
  "apps": [
    "com.google.android.deskclock",
    "com.sec.android.app.clockpackage",
    "com.android.deskclock"
  ],
  "app_label": "Clock",
  "app_names": [
    "Clock",
    "घड़ी",
    "கடிகாரம்",
    "గడియారం",
    "ಗಡಿಯಾರ",
    "ക്ലോക്ക്"
  ],
  "triggers": [
    {
      "all": [
        [
          "timer",
          "टाइमर",
          "டைமர்",
          "టైమర్",
          "ಟೈಮರ್",
          "ടൈമർ"
        ]
      ]
    }
  ],
  "unless": [
    "stop",
    "रोक",
    "बंद",
    "நிறுத்த",
    "ஆஃப்",
    "அணை",
    "ఆపు",
    "ఆప",
    "ఆఫ్",
    "ನಿಲ್ಲಿ",
    "ಆಫ್",
    "ನಿಲ್ಲಿಸ",
    "നിർത്ത",
    "ഓഫ്"
  ],
  "examples": {
    "hi-IN": [
      "दस मिनट का टाइमर लगाना है"
    ],
    "ta-IN": [
      "பத்து நிமிட டைமர் வைக்க வேண்டும்"
    ],
    "te-IN": [
      "పది నిమిషాల టైమర్ పెట్టాలి"
    ],
    "kn-IN": [
      "ಹತ್ತು ನಿಮಿಷದ ಟೈಮರ್ ಇಡಬೇಕು"
    ],
    "ml-IN": [
      "പത്ത് മിനിറ്റ് ടൈമർ വെക്കണം"
    ],
    "en-IN": [
      "set a timer for ten minutes"
    ]
  },
  "steps": [
    {
      "id": "start",
      "after": {
        "step": "tab",
        "min": 1
      },
      "target": [
        "Start"
      ],
      "exact": true,
      "status": "done",
      "say": {
        "hi-IN": "मिनट दबाइए, फिर नीचे 'Start' वाला बटन दबाइए।",
        "ta-IN": "நிமிடங்களை அழுத்தி, பிறகு கீழே உள்ள 'Start' பொத்தானை அழுத்துங்கள்.",
        "te-IN": "నిమిషాలు నొక్కి, తర్వాత కింద ఉన్న 'Start' బటన్ నొక్కండి.",
        "kn-IN": "ನಿಮಿಷಗಳನ್ನು ಒತ್ತಿ, ನಂತರ ಕೆಳಗಿನ 'Start' ಬಟನ್ ಒತ್ತಿ.",
        "ml-IN": "മിനിറ്റുകൾ അമർത്തി, പിന്നെ താഴെയുള്ള 'Start' ബട്ടൺ അമർത്തുക.",
        "en-IN": "Press the minutes, then press the 'Start' button at the bottom."
      }
    },
    {
      "id": "tab",
      "target": [
        "Timer"
      ],
      "exact": true,
      "say": {
        "hi-IN": "नीचे '{label}' पर दबाइए।",
        "ta-IN": "கீழே '{label}' ஐ அழுத்துங்கள்.",
        "te-IN": "కింద '{label}' నొక్కండి.",
        "kn-IN": "ಕೆಳಗೆ '{label}' ಒತ್ತಿ.",
        "ml-IN": "താഴെ '{label}' അമർത്തുക.",
        "en-IN": "Press '{label}' at the bottom."
      }
    }
  ]
}
