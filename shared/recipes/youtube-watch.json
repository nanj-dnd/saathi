  "examples": {
    "hi-IN": [
      "यूट्यूब पर भजन सुनना है",
      "youtube chalana hai",
      "भजन सुनना है"
    ],
    "ta-IN": [
      "யூடியூபில் பாட்டு கேட்க வேண்டும்"
    ],
    "te-IN": [
      "యూట్యూబ్‌లో పాటలు చూడాలి"
    ],
    "kn-IN": [
      "ಯೂಟ್ಯೂಬ್‌ನಲ್ಲಿ ಹಾಡು ಕೇಳಬೇಕು"
    ],
    "ml-IN": [
      "യൂട്യൂബിൽ പാട്ട് കേൾക്കണം"
    ]
  },
  "steps": [
    {
      "id": "play",
      "after": {
        "step": "search",
        "min": 1
      },
      "screen_has": [
        [
          "views"
        ]
      ],
      "status": "done",
      "say": {
        "hi-IN": "जो वीडियो देखना है, उस पर दबाइए।",
        "ta-IN": "பார்க்க வேண்டிய வீடியோவை அழுத்துங்கள்.",
        "te-IN": "చూడాలనుకున్న వీడియో మీద నొక్కండి.",
        "kn-IN": "ನೋಡಬೇಕಾದ ವೀಡಿಯೊ ಮೇಲೆ ಒತ್ತಿ.",
        "ml-IN": "കാണേണ്ട വീഡിയോയിൽ അമർത്തുക."
      }
    },
    {
      "id": "mic",
      "after": {
        "step": "search",
        "min": 1
      },
      "target": [
        "Search with your voice",
        "Voice search"
      ],
      "exact": true,
      "max_repeats": 2,
      "say": {
        "hi-IN": "माइक वाला निशान दबाइए और बोलिए क्या देखना है।",
        "ta-IN": "மைக் குறியை அழுத்தி என்ன பார்க்க வேண்டும் என்று சொல்லுங்கள்.",
        "te-IN": "మైక్ గుర్తు నొక్కి ఏం చూడాలో చెప్పండి.",
        "kn-IN": "ಮೈಕ್ ಗುರುತು ಒತ್ತಿ ಏನು ನೋಡಬೇಕು ಎಂದು ಹೇಳಿ.",
        "ml-IN": "മൈക്ക് അടയാളം അമർത്തി എന്താണ് കാണേണ്ടതെന്ന് പറയുക."
      }
    },
    {
      "id": "search",
      "target": [
        "Search"
      ],
      "exact": true,
      "say": {
        "hi-IN": "ऊपर दाईं ओर छोटे गोल शीशे वाला निशान दबाइए, यह खोजने के लिए है।",
        "ta-IN": "மேலே வலது பக்கம் உள்ள சிறிய பூதக்கண்ணாடி குறியை அழுத்துங்கள், இது தேடுவதற்கு.",
        "te-IN": "పైన కుడి వైపు ఉన్న చిన్న భూతద్దం గుర్తు నొక్కండి, ఇది వెతకడానికి.",
        "kn-IN": "ಮೇಲೆ ಬಲಭಾಗದಲ್ಲಿರುವ ಚಿಕ್ಕ ಭೂತಗನ್ನಡಿ ಗುರುತು ಒತ್ತಿ, ಇದು ಹುಡುಕಲು.",
        "ml-IN": "മുകളിൽ വലതുവശത്തുള്ള ചെറിയ ഭൂതക്കണ്ണാടി അടയാളം അമർത്തുക, ഇത് തിരയാനാണ്."
      }
    }
  ]
}
