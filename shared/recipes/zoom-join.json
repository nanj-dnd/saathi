          "zoom",
          "ज़ूम मीटिंग",
          "जूम मीटिंग",
          "ज़ूम पर",
          "जूम पर",
          "ஜூம் மீட்டிங்",
          "జూమ్ మీటింగ్",
          "ಜೂಮ್ ಮೀಟಿಂಗ್",
          "സൂം മീറ്റിംഗ്"
        ],
        [
          "join",
          "जॉइन",
          "जुड़",
          "जुड",
          "शामिल",
          "meeting",
          "मीटिंग",
          "சேர",
          "மீட்டிங்",
          "చేర",
          "మీటింగ్",
          "ಸೇರ",
          "ಮೀಟಿಂಗ್",
