          "മീറ്റിംഗ്",
          "satsang",
          "सत्संग",
          "class",
          "क्लास"
        ]
      ]
    },
    {
      "all": [
        [
          "join",
          "जॉइन",
          "जुड़",
          "जुड",
          "शामिल",
          "meeting",
          "मीटिंग",
          "சேர",
          "மீட்டிங்",
          "చేర",
          "మీటింగ్",
          "ಸೇರ",
          "ಮೀಟಿಂಗ್",
          "ചേര",
          "മീറ്റിംഗ്",
          "satsang",
          "सत्संग",
          "class",
          "क्लास"
        ]
      ],
      "in_app": true
    }
  ],
  "examples": {
    "hi-IN": [
      "ज़ूम पर सत्संग में जुड़ना है",
      "zoom meeting join karni hai"
    ],
    "ta-IN": [
      "ஜூம் மீட்டிங்கில் சேர வேண்டும்"
    ],
    "te-IN": [
      "జూమ్ మీటింగ్‌లో చేరాలి"
    ],
    "kn-IN": [
      "ಜೂಮ್ ಮೀಟಿಂಗ್‌ಗೆ ಸೇರಬೇಕು"
    ],
    "ml-IN": [
      "സൂം മീറ്റിംഗിൽ ചേരണം"
    ]
  },
  "steps": [
    {
      "id": "audio",
      "target": [
        "Wifi or Cellular Data",
        "Call over Internet",
        "Join Audio",
        "Join with Video"
      ],
      "status": "done",
      "say": {
        "hi-IN": "'{label}' दबाइए ताकि आप सुन और बोल सकें।",
        "ta-IN": "நீங்கள் கேட்கவும் பேசவும் '{label}' ஐ அழுத்துங்கள்.",
        "te-IN": "మీరు వినడానికి, మాట్లాడడానికి '{label}' నొక్కండి.",
        "kn-IN": "ನೀವು ಕೇಳಲು ಮತ್ತು ಮಾತನಾಡಲು '{label}' ಒತ್ತಿ.",
        "ml-IN": "നിങ്ങൾക്ക് കേൾക്കാനും സംസാരിക്കാനും '{label}' അമർത്തുക."
      }
    },
    {
      "id": "enter",
      "after": {
        "step": "join",
        "min": 1
      },
      "screen_has": [
        [
          "Meeting ID",
          "Personal Link Name"
        ]
      ],
      "max_repeats": 2,
      "say": {
        "hi-IN": "मीटिंग का नंबर (ID) लिखिए, फिर नीचे 'Join' दबाइए।",
        "ta-IN": "மீட்டிங் எண்ணை (ID) எழுதி, பிறகு கீழே 'Join' ஐ அழுத்துங்கள்.",
        "te-IN": "మీటింగ్ నంబర్ (ID) రాసి, తర్వాత కింద 'Join' నొక్కండి.",
        "kn-IN": "ಮೀಟಿಂಗ್ ನಂಬರ್ (ID) ಬರೆದು, ನಂತರ ಕೆಳಗೆ 'Join' ಒತ್ತಿ.",
        "ml-IN": "മീറ്റിംഗ് നമ്പർ (ID) എഴുതി, പിന്നെ താഴെ 'Join' അമർത്തുക."
      }
    },
    {
      "id": "join",
      "target": [
        "Join a Meeting",
        "Join meeting",
        "Join"
      ],
      "exact": true,
      "say": {
        "hi-IN": "'{label}' पर दबाइए।",
        "ta-IN": "'{label}' ஐ அழுத்துங்கள்.",
        "te-IN": "'{label}' నొక్కండి.",
        "kn-IN": "'{label}' ಒತ್ತಿ.",
        "ml-IN": "'{label}' അമർത്തുക."
      }
    }
  ]
}
