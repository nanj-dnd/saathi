        ],
        [
          "track",
          "ट्रैक",
          "कहाँ",
          "कहां",
          "कब आएगा",
          "कब आयेगा",
          "status",
          "स्टेटस",
          "எங்கே",
          "எப்போது வரும்",
          "ఎక్కడ",
          "ఎప్పుడు వస్తుంది",
          "ಎಲ್ಲಿ",
          "ಯಾವಾಗ ಬರುತ್ತದೆ",
          "എവിടെ",
          "എപ്പോൾ വരും"
        ]
      ]
    },
    {
      "all": [
        [
          "track",
          "ट्रैक",
          "कहाँ",
          "कहां",
          "कब आएगा",
          "कब आयेगा",
          "status",
          "स्टेटस",
          "எங்கே",
          "எப்போது வரும்",
          "ఎక్కడ",
          "ఎప్పుడు వస్తుంది",
          "ಎಲ್ಲಿ",
          "ಯಾವಾಗ ಬರುತ್ತದೆ",
          "എവിടെ",
          "എപ്പോൾ വരും"
        ],
        [
          "order",
          "ऑर्डर",
          "सामान",
          "parcel",
          "पार्सल",
          "ஆர்டர்",
          "ఆర్డర్",
          "ಆರ್ಡರ್",
          "ഓർഡർ"
        ]
      ],
      "in_app": true
    }
  ],
  "examples": {
    "hi-IN": [
      "अमेज़न का सामान कब आएगा"
    ],
    "ta-IN": [
      "அமேசான் ஆர்டர் எப்போது வரும்"
    ],
    "te-IN": [
      "అమెజాన్ ఆర్డర్ ఎప్పుడు వస్తుంది"
    ],
    "kn-IN": [
      "ಅಮೆಜಾನ್ ಆರ್ಡರ್ ಯಾವಾಗ ಬರುತ್ತದೆ"
    ],
    "ml-IN": [
      "ആമസോൺ ഓർഡർ എപ്പോൾ വരും"
    ],
    "en-IN": [
      "track my Amazon parcel"
    ]
  },
  "steps": [
    {
      "id": "orders",
      "target": [
        "Your Orders",
        "Orders"
      ],
      "status": "done",
      "say": {
        "hi-IN": "'{label}' दबाइए। वहाँ हर सामान के आगे लिखा होगा कि वह कब आएगा।",
        "ta-IN": "'{label}' ஐ அழுத்துங்கள். ஒவ்வொரு பொருளுக்கும் எப்போது வரும் என்று எழுதியிருக்கும்.",
        "te-IN": "'{label}' నొక్కండి. ప్రతి వస్తువు ఎప్పుడు వస్తుందో అక్కడ రాసి ఉంటుంది.",
        "kn-IN": "'{label}' ಒತ್ತಿ. ಪ್ರತಿ ವಸ್ತು ಯಾವಾಗ ಬರುತ್ತದೆ ಎಂದು ಅಲ್ಲಿ ಬರೆದಿರುತ್ತದೆ.",
        "ml-IN": "'{label}' അമർത്തുക. ഓരോ സാധനവും എപ്പോൾ വരുമെന്ന് അവിടെ എഴുതിയിരിക്കും.",
        "en-IN": "Press '{label}'. Next to each item it will say when it will arrive."
      }
    },
    {
      "id": "account",
      "target": [
        "You",
        "Account",
        "Your Account"
      ],
      "exact": true,
      "say": {
        "hi-IN": "नीचे '{label}' पर दबाइए।",
        "ta-IN": "கீழே '{label}' ஐ அழுத்துங்கள்.",
        "te-IN": "కింద '{label}' నొక్కండి.",
        "kn-IN": "ಕೆಳಗೆ '{label}' ಒತ್ತಿ.",
        "ml-IN": "താഴെ '{label}' അമർത്തുക.",
        "en-IN": "Press '{label}' at the bottom."
      }
    }
  ]
}
