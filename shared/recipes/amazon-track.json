    "in.amazon.mShop.android.shopping"
  ],
  "app_label": "Amazon",
  "app_names": [
    "Amazon",
    "Amazon Shopping"
  ],
  "triggers": [
    {
      "all": [
        [
          "amazon",
          "अमेज़न",
