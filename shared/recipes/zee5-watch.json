{
  "id": "zee5-watch",
  "version": 1,
  "goal": "watch something on ZEE5",
  "apps": [
    "com.graymatrix.did"
  ],
  "app_label": "ZEE5",
  "app_names": [
    "ZEE5",
    "ज़ी5"
  ],
  "triggers": [
    {
      "all": [
        [
          "zee5",
          "zee 5",
          "ज़ी5",
          "जी5",
          "ज़ी 5",
          "ज़ी फाइव",
          "जी फाइव",
          "ஜீ5",
          "ஜீ 5",
          "జీ5",
          "జీ 5",
          "ಜೀ5",
          "ಜೀ 5",
          "സീ5",
          "സീ 5"
        ]
      ]
    }
  ],
  "examples": {
    "hi-IN": [
      "ज़ी5 पर सीरियल देखना है"
    ],
    "en-IN": [
      "watch a serial on ZEE5"
    ],
    "ta-IN": [
      "ஜீ5-ல் சீரியல் பார்க்க வேண்டும்"
    ],
    "te-IN": [
      "జీ5 లో సీరియల్ చూడాలి"
    ],
    "kn-IN": [
      "ಜೀ5 ನಲ್ಲಿ ಧಾರಾವಾಹಿ ನೋಡಬೇಕು"
    ],
    "ml-IN": [
      "സീ5-ൽ സീരിയൽ കാണണം"
    ]
  },
  "steps": [
    {
      "id": "type",
      "after": {
        "step": "search",
        "min": 1
      },
      "status": "done",
      "say": {
        "hi-IN": "जो देखना है उसका नाम बोलिए या लिखिए, फिर नीचे उस पर दबाइए।",
        "en-IN": "Say or write the name of what you want to watch, then press it below.",
        "ta-IN": "பார்க்க வேண்டியதன் பெயரைச் சொல்லுங்கள் அல்லது எழுதுங்கள், பிறகு கீழே அதை அழுத்துங்கள்.",
        "te-IN": "చూడాల్సిన దాని పేరు చెప్పండి లేదా రాయండి, తర్వాత కింద దాని మీద నొక్కండి.",
        "kn-IN": "ನೋಡಬೇಕಾದುದರ ಹೆಸರು ಹೇಳಿ ಅಥವಾ ಬರೆಯಿರಿ, ನಂತರ ಕೆಳಗೆ ಅದರ ಮೇಲೆ ಒತ್ತಿ.",
        "ml-IN": "കാണേണ്ടതിന്റെ പേര് പറയുക അല്ലെങ്കിൽ എഴുതുക, പിന്നെ താഴെ അതിൽ അമർത്തുക."
      }
    },
    {
      "id": "search",
      "target": [
        "Search"
      ],
      "exact": true,
      "say": {
        "hi-IN": "नीचे 'Search' वाला निशान दबाइए।",
        "en-IN": "Press the 'Search' symbol at the bottom.",
        "ta-IN": "கீழே உள்ள 'Search' குறியை அழுத்துங்கள்.",
        "te-IN": "కింద ఉన్న 'Search' గుర్తు నొక్కండి.",
        "kn-IN": "ಕೆಳಗಿನ 'Search' ಗುರುತು ಒತ್ತಿ.",
        "ml-IN": "താഴെയുള്ള 'Search' അടയാളം അമർത്തുക."
      }
    }
  ]
}
