        "kn-IN": "ಯಾರ ಸ್ಟೇಟಸ್ ನೋಡಬೇಕೋ, ಅವರ ವೃತ್ತದ ಫೋಟೋ ಮೇಲೆ ಒತ್ತಿ.",
        "ml-IN": "ആരുടെ സ്റ്റാറ്റസ് കാണണോ, അവരുടെ വട്ടത്തിലുള്ള ഫോട്ടോയിൽ അമർത്തുക.",
        "en-IN": "Press the round photo of the person whose status you want to see."
      }
    },
    {
      "id": "updates",
      "target": [
        "Updates",
        "Status"
      ],
      "exact": true,
      "say": {
        "hi-IN": "नीचे '{label}' पर दबाइए।",
        "ta-IN": "கீழே '{label}' ஐ அழுத்துங்கள்.",
        "te-IN": "కింద '{label}' నొక్కండి.",
        "kn-IN": "ಕೆಳಗೆ '{label}' ಒತ್ತಿ.",
        "ml-IN": "താഴെ '{label}' അമർത്തുക.",
        "en-IN": "Press '{label}' at the bottom."
      }
    }
