{
  "id": "clock-alarm",
  "version": 2,
  "goal": "set an alarm",
  "apps": [
    "com.google.android.deskclock",
    "com.sec.android.app.clockpackage",
    "com.android.deskclock"
  ],
  "app_label": "Clock",
  "app_names": [
    "Clock",
    "घड़ी",
    "கடிகாரம்",
    "గడియారం",
    "ಗಡಿಯಾರ",
    "ക്ലോക്ക്"
  ],
  "triggers": [
    {
      "all": [
        [
          "alarm",
          "अलार्म",
          "அலார",
          "అలార",
          "ಅಲಾರ",
          "അലാറ"
        ]
      ]
    }
  ],
  "unless": [
    "stop",
    "रोक",
    "बंद",
    "நிறுத்த",
    "ஆஃப்",
    "அணை",
    "ఆపు",
    "ఆప",
    "ఆఫ్",
    "ನಿಲ್ಲಿ",
    "ಆಫ್",
    "ನಿಲ್ಲಿಸ",
    "നിർത്ത",
    "ഓഫ്"
  ],
  "examples": {
    "hi-IN": [
      "सुबह का अलार्म लगाना है"
    ],
    "ta-IN": [
      "காலை அலாரம் வைக்க வேண்டும்"
    ],
    "te-IN": [
      "ఉదయం అలారం పెట్టాలి"
    ],
    "kn-IN": [
      "ಬೆಳಿಗ್ಗೆ ಅಲಾರಂ ಇಡಬೇಕು"
    ],
    "ml-IN": [
      "രാവിലെ അലാറം വെക്കണം"
    ],
    "en-IN": [
      "set an alarm for six in the morning"
    ]
  },
  "steps": [
    {
      "id": "done",
      "after": {
        "step": "time",
        "min": 1
      },
      "screen_has": [
        [
          "Alarm"
        ]
      ],
      "screen_lacks": [
        "OK",
        "Cancel"
      ],
      "exact": true,
      "status": "done",
      "say": {
        "hi-IN": "अलार्म लग गया।",
        "ta-IN": "அலாரம் வைக்கப்பட்டது.",
        "te-IN": "అలారం పెట్టబడింది.",
        "kn-IN": "ಅಲಾರಂ ಇಡಲಾಗಿದೆ.",
        "ml-IN": "അലാറം വെച്ചു.",
        "en-IN": "The alarm is set."
      }
    },
    {
      "id": "time",
      "after": {
        "step": "add",
        "min": 1
      },
      "target": [
        "OK"
      ],
      "exact": true,
      "max_repeats": 2,
      "say": {
        "hi-IN": "घंटा और मिनट चुनिए, AM या PM देख लीजिए, फिर 'OK' दबाइए।",
        "ta-IN": "மணி, நிமிடத்தைத் தேர்ந்தெடுங்கள், AM அல்லது PM பாருங்கள், பிறகு 'OK' ஐ அழுத்துங்கள்.",
        "te-IN": "గంట, నిమిషం ఎంచుకోండి, AM లేదా PM చూడండి, తర్వాత 'OK' నొక్కండి.",
        "kn-IN": "ಗಂಟೆ, ನಿಮಿಷ ಆಯ್ಕೆ ಮಾಡಿ, AM ಅಥವಾ PM ನೋಡಿ, ನಂತರ 'OK' ಒತ್ತಿ.",
        "ml-IN": "മണിക്കൂറും മിനിറ്റും തിരഞ്ഞെടുക്കുക, AM ആണോ PM ആണോ നോക്കുക, പിന്നെ 'OK' അമർത്തുക.",
        "en-IN": "Choose the hour and minutes, check AM or PM, then press 'OK'."
      }
    },
    {
      "id": "add",
      "target": [
        "Add alarm"
      ],
      "exact": true,
      "say": {
        "hi-IN": "नीचे बीच में '+' वाला बटन दबाइए।",
        "ta-IN": "கீழே நடுவில் உள்ள '+' பொத்தானை அழுத்துங்கள்.",
        "te-IN": "కింద మధ్యలో ఉన్న '+' బటన్ నొక్కండి.",
        "kn-IN": "ಕೆಳಗೆ ಮಧ್ಯದ '+' ಬಟನ್ ಒತ್ತಿ.",
        "ml-IN": "താഴെ നടുവിലുള്ള '+' ബട്ടൺ അമർത്തുക.",
        "en-IN": "Press the '+' button in the middle at the bottom."
      }
    },
    {
      "id": "tab",
      "target": [
        "Alarm",
        "Alarms"
      ],
      "exact": true,
      "say": {
        "hi-IN": "नीचे '{label}' पर दबाइए।",
        "ta-IN": "கீழே '{label}' ஐ அழுத்துங்கள்.",
        "te-IN": "కింద '{label}' నొక్కండి.",
        "kn-IN": "ಕೆಳಗೆ '{label}' ಒತ್ತಿ.",
        "ml-IN": "താഴെ '{label}' അമർത്തുക.",
        "en-IN": "Press '{label}' at the bottom."
      }
    }
  ]
}
