  "steps": [
    {
      "id": "sysupdate",
      "target": [
        "System update",
        "Software updates",
        "Software update"
      ],
      "say": {
        "hi-IN": "'{label}' पर दबाइए।",
        "ta-IN": "'{label}' ஐ அழுத்துங்கள்.",
        "te-IN": "'{label}' నొక్కండి.",
        "kn-IN": "'{label}' ಒತ್ತಿ.",
        "ml-IN": "'{label}' അമർത്തുക."
      }
    },
    {
      "id": "check",
      "target": [
        "Check for update",
        "Check for updates",
        "Download and install",
        "Install now"
      ],
      "status": "done",
      "say": {
        "hi-IN": "'{label}' दबाइए। अपडेट में समय लगता है; फ़ोन को चार्जिंग पर और वाई-फाई से जोड़कर रखिए। बीच में फ़ोन बंद मत कीजिए।",
        "ta-IN": "'{label}' ஐ அழுத்துங்கள். அப்டேட்டுக்கு நேரம் ஆகும்; போனை சார்ஜிலும் Wi-Fi-லும் வையுங்கள். இடையில் போனை அணைக்காதீர்கள்.",
        "te-IN": "'{label}' నొక్కండి. అప్‌డేట్‌కు సమయం పడుతుంది; ఫోన్‌ను ఛార్జింగ్‌లో, Wi-Fi తో ఉంచండి. మధ్యలో ఫోన్ ఆపకండి.",
        "kn-IN": "'{label}' ಒತ್ತಿ. ಅಪ್‌ಡೇಟ್‌ಗೆ ಸಮಯ ಬೇಕು; ಫೋನನ್ನು ಚಾರ್ಜಿಂಗ್‌ನಲ್ಲಿ ಮತ್ತು Wi-Fi ಗೆ ಜೋಡಿಸಿ ಇಡಿ. ಮಧ್ಯದಲ್ಲಿ ಫೋನ್ ಆಫ್ ಮಾಡಬೇಡಿ.",
        "ml-IN": "'{label}' അമർത്തുക. അപ്ഡേറ്റിന് സമയമെടുക്കും; ഫോൺ ചാർജിലും Wi-Fi-യിലും വെക്കുക. ഇടയ്ക്ക് ഫോൺ ഓഫാക്കരുത്."
      }
    },
