{
  "id": "gallery-share",
  "version": 2,
  "goal": "send a photo from the gallery",
  "apps": [
    "com.google.android.apps.photos",
    "com.sec.android.gallery3d",
    "com.miui.gallery",
    "com.coloros.gallery3d",
    "com.vivo.gallery",
    "com.android.gallery3d"
  ],
  "app_label": "Gallery",
  "app_names": [
    "Gallery",
    "Photos",
    "गैलरी"
  ],
  "triggers": [
    {
      "all": [
        [
          "gallery",
          "गैलरी",
          "गेलरी",
          "photos app",
          "கேலரி",
          "గ్యాలరీ",
          "ಗ್ಯಾಲರಿ",
          "ഗാലറി"
        ],
        [
          "send",
          "share",
          "भेज",
          "அனுப்ப",
          "పంప",
          "ಕಳುಹಿಸ",
          "ಕಳಿಸ",
          "അയക്ക",
          "അയയ്ക്ക"
        ]
      ]
    },
    {
      "all": [
        [
          "photo",
          "picture",
          "pic",
          "फोटो",
          "फ़ोटो",
          "तस्वीर",
          "புகைப்பட",
          "போட்டோ",
          "ஃபோட்டோ",
          "ఫోటో",
          "ఫొటో",
          "ಫೋಟೋ",
          "ಫೋಟೊ",
          "ഫോട്ടോ"
        ],
        [
          "send",
          "share",
          "भेज",
          "அனுப்ப",
          "పంప",
          "ಕಳುಹಿಸ",
          "ಕಳಿಸ",
          "അയക്ക",
          "അയയ്ക്ക"
        ]
      ],
      "in_app": true
    }
  ],
  "examples": {
    "hi-IN": [
      "गैलरी से फोटो भेजनी है"
    ],
    "ta-IN": [
      "கேலரியிலிருந்து போட்டோ அனுப்ப வேண்டும்"
    ],
    "te-IN": [
      "గ్యాలరీ నుంచి ఫోటో పంపాలి"
    ],
    "kn-IN": [
      "ಗ್ಯಾಲರಿಯಿಂದ ಫೋಟೋ ಕಳುಹಿಸಬೇಕು"
    ],
    "ml-IN": [
      "ഗാലറിയിൽ നിന്ന് ഫോട്ടോ അയക്കണം"
    ],
    "en-IN": [
      "share a picture from the gallery"
    ]
  },
  "steps": [
    {
      "id": "sent",
      "apps": [
        "com.whatsapp",
        "com.whatsapp.w4b"
      ],
      "target": [
        "Send"
      ],
      "exact": true,
      "status": "done",
      "say": {
        "hi-IN": "हरे तीर वाला बटन दबाइए। फोटो चली जाएगी।",
        "ta-IN": "பச்சை அம்புக்குறி பொத்தானை அழுத்துங்கள். புகைப்படம் போய்விடும்.",
        "te-IN": "ఆకుపచ్చ బాణం బటన్ నొక్కండి. ఫోటో వెళ్తుంది.",
        "kn-IN": "ಹಸಿರು ಬಾಣದ ಬಟನ್ ಒತ್ತಿ. ಫೋಟೋ ಹೋಗುತ್ತದೆ.",
        "ml-IN": "പച്ച അമ്പടയാള ബട്ടൺ അമർത്തുക. ഫോട്ടോ പോകും.",
        "en-IN": "Press the green arrow button. The photo will be sent."
      }
    },
    {
      "id": "to",
      "apps": [
        "com.whatsapp",
        "com.whatsapp.w4b"
      ],
      "max_repeats": 2,
      "say": {
        "hi-IN": "जिसे फोटो भेजनी है उनके नाम पर दबाइए।",
        "ta-IN": "யாருக்கு புகைப்படம் அனுப்ப வேண்டுமோ அவர் பெயரை அழுத்துங்கள்.",
        "te-IN": "ఎవరికి ఫోటో పంపాలో వారి పేరు మీద నొక్కండి.",
        "kn-IN": "ಯಾರಿಗೆ ಫೋಟೋ ಕಳುಹಿಸಬೇಕೋ ಅವರ ಹೆಸರನ್ನು ಒತ್ತಿ.",
        "ml-IN": "ആർക്കാണ് ഫോട്ടോ അയക്കേണ്ടത്, അവരുടെ പേരിൽ അമർത്തുക.",
        "en-IN": "Press the name of the person you want to send the photo to."
      }
    },
    {
      "id": "whatsapp",
      "apps": [
        "android",
        "com.android.intentresolver",
        "com.google.android.apps.photos",
        "com.sec.android.gallery3d",
        "com.miui.gallery"
      ],
      "after": {
        "step": "share",
        "min": 1
      },
      "target": [
        "WhatsApp"
      ],
      "say": {
        "hi-IN": "'WhatsApp' पर दबाइए।",
        "ta-IN": "'WhatsApp' ஐ அழுத்துங்கள்.",
        "te-IN": "'WhatsApp' నొక్కండి.",
        "kn-IN": "'WhatsApp' ಒತ್ತಿ.",
        "ml-IN": "'WhatsApp' അമർത്തുക.",
        "en-IN": "Press 'WhatsApp'."
      }
    },
    {
      "id": "share",
      "target": [
        "Share"
      ],
      "exact": true,
      "say": {
        "hi-IN": "नीचे 'Share' वाला निशान दबाइए।",
        "ta-IN": "கீழே உள்ள 'Share' குறியை அழுத்துங்கள்.",
        "te-IN": "కింద ఉన్న 'Share' గుర్తు నొక్కండి.",
        "kn-IN": "ಕೆಳಗಿನ 'Share' ಗುರುತು ಒತ್ತಿ.",
        "ml-IN": "താഴെയുള്ള 'Share' അടയാളം അമർത്തുക.",
        "en-IN": "Press the 'Share' symbol at the bottom."
      }
    },
    {
      "id": "open",
      "max_repeats": 2,
      "say": {
        "hi-IN": "जो फोटो भेजनी है, उस पर दबाकर उसे खोलिए।",
        "ta-IN": "அனுப்ப வேண்டிய புகைப்படத்தை அழுத்தித் திறங்கள்.",
        "te-IN": "పంపాల్సిన ఫోటో మీద నొక్కి తెరవండి.",
        "kn-IN": "ಕಳುಹಿಸಬೇಕಾದ ಫೋಟೋ ಮೇಲೆ ಒತ್ತಿ ತೆರೆಯಿರಿ.",
        "ml-IN": "അയക്കേണ്ട ഫോട്ടോയിൽ അമർത്തി തുറക്കുക.",
        "en-IN": "Press the photo you want to send to open it."
      }
    }
  ]
}
